<template>
  <div class="page">
    <scroll class="detail-scroll" scroll-y="true" bounces="true">
      <div if="{{ course }}" class="content">
        <!-- 课程名称 -->
        <text class="course-name">{{ course.name }}</text>

        <!-- 时间信息 -->
        <div class="time-section">
          <text class="time-value">{{ course.startTime }}</text>
          <text class="time-arrow">→</text>
          <text class="time-value">{{ course.endTime }}</text>
        </div>

        <!-- 地点信息 -->
        <div class="info-row">
          <text class="info-label">教室</text>
          <text class="info-value">{{ course.classroom }}</text>
        </div>

        <!-- 教师信息 -->
        <div class="info-row">
          <text class="info-label">教师</text>
          <text class="info-value">{{ course.teacher }}</text>
        </div>

        <!-- 状态信息（仅今日课表进入时显示） -->
        <div if="{{ showStatus && status === 'ongoing' }}" class="status-section">
          <text class="status-text text-green">当前剩余 {{ remainingMinutes }} 分钟</text>
          <div class="progress-container">
            <progress class="progress-bar" percent="{{ progress }}"></progress>
            <text class="progress-text">{{ progressPercent }}%</text>
          </div>
        </div>

        <div if="{{ showStatus && status === 'upcoming' }}" class="status-section">
          <text class="status-text text-blue">还有 {{ minutesUntilStart }} 分钟开始</text>
        </div>

        <div if="{{ showStatus && status === 'finished' }}" class="status-section">
          <text class="status-text text-gray">已结束</text>
        </div>

        <!-- 删除区域（仅用户添加的课程显示） -->
        <div if="{{ canDelete }}" class="delete-section">
          <div if="{{ !deleteConfirming }}" class="delete-btn" onclick="onDeleteClick">
            <text class="delete-btn-text">删除课程</text>
          </div>
          <div if="{{ deleteConfirming }}" class="delete-confirm">
            <text class="delete-confirm-text">确定删除这门课程？</text>
            <div class="delete-btns">
              <div class="cancel-btn" onclick="onCancelDelete">
                <text class="cancel-btn-text">取消</text>
              </div>
              <div class="confirm-btn" onclick="onConfirmDelete">
                <text class="confirm-btn-text">确认删除</text>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div if="{{ !course }}" class="empty">
        <text class="empty-text">课程不存在</text>
      </div>

      <div class="bottom-safe-space"></div>
    </scroll>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 466px;
  height: 466px;
  padding-top: 45px;
}

.detail-scroll {
  width: 400px;
  height: 380px;
  flex-direction: column;
  align-items: center;
}

.content {
  width: 380px;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.course-name {
  font-size: 34px;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 25px;
}

.time-section {
  flex-direction: row;
  align-items: center;
  margin-bottom: 30px;
}

.time-value {
  font-size: 48px;
  font-weight: 700;
  color: #FFFFFF;
}

.time-arrow {
  font-size: 32px;
  color: #4FA3FF;
  margin: 0 20px;
}

.info-row {
  flex-direction: row;
  width: 380px;
  margin-bottom: 15px;
  padding: 15px 20px;
  background-color: #171717;
  border-radius: 20px;
}

.info-label {
  font-size: 16px;
  color: #8F8F8F;
  width: 60px;
}

.info-value {
  font-size: 20px;
  color: #FFFFFF;
  flex: 1;
}

.status-section {
  width: 380px;
  flex-direction: column;
  align-items: center;
  margin-top: 25px;
  padding: 20px;
  background-color: #171717;
  border-radius: 22px;
}

.status-text {
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 15px;
}

.progress-container {
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.progress-bar {
  flex: 1;
  color: #58D68D;
  layer-color: #2B2B2B;
  stroke-width: 10px;
}

.progress-text {
  font-size: 20px;
  font-weight: 700;
  color: #58D68D;
  margin-left: 15px;
}

.delete-section {
  width: 380px;
  margin-top: 25px;
  flex-direction: column;
  align-items: center;
}

.delete-btn {
  width: 380px;
  height: 50px;
  border-radius: 25px;
  background-color: #FF6B6B;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.delete-btn-text {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
}

.delete-confirm {
  width: 380px;
  flex-direction: column;
  align-items: center;
}

.delete-confirm-text {
  font-size: 16px;
  color: #FF6B6B;
  margin-bottom: 15px;
}

.delete-btns {
  flex-direction: row;
  justify-content: space-between;
  width: 380px;
}

.cancel-btn {
  width: 175px;
  height: 50px;
  border-radius: 25px;
  background-color: #2B2B2B;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cancel-btn-text {
  font-size: 16px;
  font-weight: 600;
  color: #FFFFFF;
}

.confirm-btn {
  width: 175px;
  height: 50px;
  border-radius: 25px;
  background-color: #FF6B6B;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.confirm-btn-text {
  font-size: 16px;
  font-weight: 600;
  color: #FFFFFF;
}

.bottom-safe-space {
  height: 80px;
  flex-shrink: 0;
}

.text-blue {
  color: #4FA3FF;
}

.text-green {
  color: #58D68D;
}

.text-gray {
  color: #666666;
}

.empty {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200px;
}

.empty-text {
  font-size: 20px;
  color: #666666;
}
</style>

<script>
import router from '@system.router'
import { getCourses, ensureStorageReady, isUserCreatedCourse, deleteCourse } from '../../common/storage'
import { getCourseStatus, getCourseProgress, getCourseRemainingTime, getMinutesUntilStart } from '../../common/schedule'
import { getNow } from '../../common/time'

export default {
  protected: {
    courseId: '',
    source: 'today'
  },

  private: {
    course: null,
    status: 'upcoming',
    progress: 0,
    progressPercent: 0,
    remainingMinutes: 0,
    minutesUntilStart: 0,
    canDelete: false,
    deleteConfirming: false,
    deleting: false,
    showStatus: true
  },

  onInit() {
    // 根据来源决定是否显示实时状态
    this.showStatus = this.source === 'today'

    ensureStorageReady()
      .then(() => {
        this.loadCourse()
      })
      .catch((err) => {
        console.error('Failed to initialize storage:', err)
        this.loadCourse()
      })
  },

  loadCourse() {
    const now = getNow()

    // 从统一课程缓存中查找课程
    this.course = getCourses().find(c => c.id === this.courseId)

    if (this.course) {
      this.canDelete = isUserCreatedCourse(this.courseId)

      // 只有从今日课表进入时才计算实时状态
      if (this.showStatus) {
        this.status = getCourseStatus(this.course, now)

        if (this.status === 'ongoing') {
          this.progress = Math.round(getCourseProgress(this.course, now) * 100)
          this.progressPercent = this.progress
          this.remainingMinutes = getCourseRemainingTime(this.course, now)
        } else if (this.status === 'upcoming') {
          this.minutesUntilStart = getMinutesUntilStart(this.course, now)
        }
      }
    }
  },

  onDeleteClick() {
    this.deleteConfirming = true
  },

  onCancelDelete() {
    this.deleteConfirming = false
  },

  onConfirmDelete() {
    if (this.deleting) return

    this.deleting = true
    deleteCourse(this.courseId)
      .then(() => {
        router.back()
      })
      .catch((err) => {
        this.deleting = false
        this.deleteConfirming = false
      })
  },

  onBackPress() {
    // 如果正在确认删除，先取消确认状态
    if (this.deleteConfirming) {
      this.deleteConfirming = false
      return true
    }
    // 否则交给系统默认返回
    return false
  }
}
</script>
