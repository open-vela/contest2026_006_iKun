  flex-direction: column;
  align-items: center;
  width: 55px;
  height: 50px;
  border-radius: 20px;
  justify-content: center;
}

.day-active {
  background-color: #4FA3FF;
}

.day-text {
  font-size: 16px;
  color: #8F8F8F;
  font-weight: 600;
}

