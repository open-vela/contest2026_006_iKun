  font-size: 14px;
  color: #A0A0A0;
  margin-bottom: 4px;
}

.card-status {
  font-size: 14px;
  font-weight: 600;
}

.day-selector {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 15px;
  padding: 0 10px;
}

