  width: 50px;
  margin-right: 10px;
}

.time-text {
  font-size: 16px;
  font-weight: 600;
}

.timeline-dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  margin-top: 4px;
  margin-right: 10px;
}

