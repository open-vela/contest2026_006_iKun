<template>
  <div class="page" ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
    <!-- 顶部标题 -->
    <div class="header">
      <text class="title">课表</text>
    </div>

    <!-- 模式切换 -->
    <div class="mode-switch">
      <div class="mode-btn {{ mode === 'today' ? 'mode-active' : '' }}" onclick="switchMode('today')">
        <text class="mode-text {{ mode === 'today' ? 'mode-text-active' : '' }}">今天</text>
      </div>
      <div class="mode-btn {{ mode === 'week' ? 'mode-active' : '' }}" onclick="switchMode('week')">
        <text class="mode-text {{ mode === 'week' ? 'mode-text-active' : '' }}">本周</text>
      </div>
    </div>

    <!-- 今日模式 -->
    <div if="{{ mode === 'today' }}" class="content">
      <text class="sub-title">{{ todayTitle }}</text>
      <div class="timeline">
        <div for="{{ todayCourses }}" class="timeline-item">
          <div class="timeline-time">
            <text class="time-text {{ $item.status === 'finished' ? 'text-gray' : ($item.status === 'ongoing' ? 'text-green' : 'text-blue') }}">{{ $item.startTime }}</text>
          </div>
          <div class="timeline-dot {{ $item.status === 'finished' ? 'dot-gray' : ($item.status === 'ongoing' ? 'dot-green' : 'dot-blue') }}"></div>
          <div class="timeline-line {{ $item.status === 'finished' ? 'line-gray' : '' }}"></div>
          <div class="timeline-card {{ $item.status === 'ongoing' ? 'card-green' : '' }}" onclick="goToDetail($item.id)">
            <text class="card-name {{ $item.status === 'finished' ? 'text-gray' : '' }}">{{ $item.name }}</text>
            <text class="card-location {{ $item.status === 'finished' ? 'text-gray' : '' }}">{{ $item.classroom }} · {{ $item.teacher }}</text>
            <text if="{{ $item.status === 'ongoing' }}" class="card-status text-green">正在进行 · 剩余{{ $item.remainingMin }}分钟</text>
            <text if="{{ $item.status === 'finished' }}" class="card-status text-gray">已结束</text>
          </div>
        </div>
      </div>
      <div if="{{ todayCourses.length === 0 }}" class="empty">
        <text class="empty-text">今日无课</text>
      </div>
    </div>

    <!-- 本周模式 -->
    <div if="{{ mode === 'week' }}" class="content">
      <!-- 星期选择器 -->
      <div class="day-selector">
        <div for="{{ weekDays }}" class="day-btn {{ selectedDay === $item.value ? 'day-active' : '' }}" onclick="selectDay($item.value)">
          <text class="day-text {{ selectedDay === $item.value ? 'day-text-active' : '' }}">{{ $item.label }}</text>
          <text if="{{ $item.isToday }}" class="today-mark">今天</text>
        </div>
      </div>

      <text class="sub-title">{{ weekDayTitle }} · {{ weekCourses.length }}节课</text>

      <div class="week-list">
        <div for="{{ weekCourses }}" class="week-item" onclick="goToDetail($item.id)">
          <text class="week-time {{ $item.status === 'finished' ? 'text-gray' : 'text-blue' }}">{{ $item.startTime }}</text>
          <text class="week-name {{ $item.status === 'finished' ? 'text-gray' : '' }}">{{ $item.name }}</text>
          <text class="week-location {{ $item.status === 'finished' ? 'text-gray' : '' }}">{{ $item.classroom }}</text>
        </div>
      </div>

      <div if="{{ weekCourses.length === 0 }}" class="empty">
        <text class="empty-text">该日无课</text>
      </div>
    </div>
  </div>
</template>

<style>
