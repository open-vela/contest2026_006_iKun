</style>

<script>
import router from '@system.router'
import { getTodayCourses, getCoursesByWeekday, getAllCoursesByWeekday, formatCourseWeeks, getCourseStatus, getCourseRemainingTime, calculateCurrentWeek } from '../../common/schedule'
import { getNow, getWeekdayNumber } from '../../common/time'
import { ensureStorageReady, refreshCoursesFromStorage, refreshSemesterStartFromStorage, getSemesterWeek1Start, syncMockDataSetting } from '../../common/storage'

const DEBUG_NOW = null

export default {
  private: {
    isInitialized: false,
    mode: 'today',
    currentWeek: 1,
    selectedWeek: 1,
    selectedDay: 1,
    displayMonth: 0,
    todayTitle: '',
    weekDayTitle: '',
    allDayTitle: '',
    todayCourses: [],
    weekCourses: [],
    allCourses: [],
    weekDays: [
      { label: '一', value: 1, date: 0, month: 0, isToday: false },
      { label: '二', value: 2, date: 0, month: 0, isToday: false },
      { label: '三', value: 3, date: 0, month: 0, isToday: false },
      { label: '四', value: 4, date: 0, month: 0, isToday: false },
      { label: '五', value: 5, date: 0, month: 0, isToday: false },
      { label: '六', value: 6, date: 0, month: 0, isToday: false },
      { label: '日', value: 7, date: 0, month: 0, isToday: false }
    ]
  },

  onInit() {
    ensureStorageReady()
      .then(() => syncMockDataSetting())
      .then(() => Promise.all([
        refreshCoursesFromStorage(),
        refreshSemesterStartFromStorage()
      ]))
      .then(() => {
        const now = getNow(DEBUG_NOW)
        this.selectedDay = getWeekdayNumber(now)
        this.currentWeek = calculateCurrentWeek(now)
        // 学期未开始时，默认显示第1周
        this.selectedWeek = this.currentWeek > 0 ? this.currentWeek : 1

        this.updateWeekDates(now)
        this.loadTodayCourses(now)
        this.loadWeekCourses(now)
        this.loadAllCourses()
        this.isInitialized = true
      })
      .catch((err) => {
        console.error('Failed to initialize schedule:', err)
        this.isInitialized = true
      })
  },

  onShow() {
    if (!this.isInitialized) return
    
    ensureStorageReady()
      .then(() => syncMockDataSetting())
      .then(() => Promise.all([
        refreshCoursesFromStorage(),
        refreshSemesterStartFromStorage()
      ]))
      .then(() => {
        const now = getNow(DEBUG_NOW)
        this.currentWeek = calculateCurrentWeek(now)
        // 学期未开始时，默认显示第1周
        this.selectedWeek = this.currentWeek > 0 ? this.currentWeek : 1
        this.updateWeekDates(now)
        this.loadTodayCourses(now)
        this.loadWeekCourses(now)
        this.loadAllCourses()
      })
      .catch((err) => {
        console.error('Failed to refresh schedule:', err)
      })
  },

  // 计算 selectedWeek 对应的日期
  // 根据 semesterWeek1Start 直接计算，不依赖当前自然周
  updateWeekDates(now) {
    const semesterStart = getSemesterWeek1Start()
    let targetMonday

    if (semesterStart && this.selectedWeek > 0) {
      // 根据学期第一周直接计算目标教学周的周一
      // 第1周：semesterWeek1Start
      // 第N周：semesterWeek1Start + (N-1) * 7天
      const week1Monday = new Date(semesterStart + 'T00:00:00')
      targetMonday = new Date(week1Monday)
      targetMonday.setDate(targetMonday.getDate() + (this.selectedWeek - 1) * 7)
    } else {
      // 未设置学期第一周时，使用当前自然周作为第1周基准
      const currentWeekday = getWeekdayNumber(now)
      const mondayOffset = currentWeekday - 1
      const monday = new Date(now)
      monday.setDate(monday.getDate() - mondayOffset)
      // 增加 (selectedWeek - 1) * 7 天来计算目标周
      targetMonday = new Date(monday)
      targetMonday.setDate(targetMonday.getDate() + (this.selectedWeek - 1) * 7)
    }

    // 更新 weekDays 的日期和月份
    this.weekDays.forEach((d, index) => {
      const date = new Date(targetMonday)
      date.setDate(date.getDate() + index)
      d.date = date.getDate()
      d.month = date.getMonth() + 1
      // 只有查看当前周时才标记今天
      d.isToday = (this.selectedWeek === this.currentWeek) && (d.value === this.selectedDay)
    })

    // 根据 selectedDay 更新 displayMonth
    const selectedDayItem = this.weekDays.find(d => d.value === this.selectedDay)
    if (selectedDayItem) {
      this.displayMonth = selectedDayItem.month
    }
  },

  loadTodayCourses(now) {
    const courses = getTodayCourses(now, this.currentWeek)
    const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
    this.todayTitle = `${days[now.getDay()]} · 共${courses.length}节`

    this.todayCourses = courses.map(c => ({
      ...c,
      status: getCourseStatus(c, now),
      remainingMin: getCourseRemainingTime(c, now)
    }))
  },

  loadWeekCourses(now) {
    const courses = getCoursesByWeekday(this.selectedDay, this.selectedWeek)
    const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
    const dayIndex = this.selectedDay === 7 ? 0 : this.selectedDay
    this.weekDayTitle = `${days[dayIndex]}`

    // 判断是否是当天，只有当天才计算实时状态
    const isToday = this.selectedWeek === this.currentWeek && this.selectedDay === getWeekdayNumber(now)

    this.weekCourses = courses.map(c => ({
      ...c,
      status: isToday ? getCourseStatus(c, now) : 'upcoming'
    }))
  },

  loadAllCourses() {
    const courses = getAllCoursesByWeekday(this.selectedDay)
    const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
    const dayIndex = this.selectedDay === 7 ? 0 : this.selectedDay
    this.allDayTitle = `${days[dayIndex]}`

    this.allCourses = courses.map(c => ({
      ...c,
      weeksText: formatCourseWeeks(c.weeks)
    }))
  },

  switchMode(mode) {
    this.mode = mode
  },

  selectDay(day) {
    this.selectedDay = day
    // 根据 selectedDay 更新 displayMonth
    const selectedDayItem = this.weekDays.find(d => d.value === day)
    if (selectedDayItem) {
      this.displayMonth = selectedDayItem.month
    }
    const now = getNow(DEBUG_NOW)
    this.loadWeekCourses(now)
    this.loadAllCourses()
  },

  previousWeek() {
    // 最小值为1，不能进入第0周
    if (this.selectedWeek > 1) {
      this.selectedWeek -= 1
      const now = getNow(DEBUG_NOW)
      this.updateWeekDates(now)
      this.loadWeekCourses(now)
    }
  },

  nextWeek() {
    if (this.selectedWeek < 16) {
      this.selectedWeek += 1
      const now = getNow(DEBUG_NOW)
      this.updateWeekDates(now)
      this.loadWeekCourses(now)
    }
  },

  goToDetail(courseId, source) {
    router.push({
      uri: '/pages/course-detail',
      params: {
        courseId: courseId,
        source: source || 'today'
      }
    })
  },

  goToAddCourse() {
    router.push({
      uri: '/pages/course-add'
    })
  },

  goToSettings() {
    router.push({
      uri: '/pages/schedule-settings'
    })
  }
}
</script>
