<template>
  <div class="page">
    <!-- 顶部标题 -->
    <div class="header">
      <text class="title">课表</text>
      <div class="settings-btn" onclick="goToSettings">
        <image class="settings-icon" src="../../common/icons/settings.png"></image>
      </div>
    </div>

    <!-- 加载状态 -->
    <div if="{{ !isInitialized }}" class="loading-container">
      <text class="loading-text">加载中...</text>
    </div>

    <!-- 模式切换 + 添加按钮 -->
    <div if="{{ isInitialized }}" class="mode-row">
      <div class="mode-switch">
        <div class="mode-btn {{ mode === 'today' ? 'mode-active' : '' }}" onclick="switchMode('today')">
          <text class="mode-text {{ mode === 'today' ? 'mode-text-active' : '' }}">今天</text>
        </div>
        <div class="mode-btn {{ mode === 'week' ? 'mode-active' : '' }}" onclick="switchMode('week')">
          <text class="mode-text {{ mode === 'week' ? 'mode-text-active' : '' }}">本周</text>
        </div>
        <div class="mode-btn {{ mode === 'all' ? 'mode-active' : '' }}" onclick="switchMode('all')">
          <text class="mode-text {{ mode === 'all' ? 'mode-text-active' : '' }}">全部</text>
        </div>
      </div>
      <div class="add-btn" onclick="goToAddCourse">
        <text class="add-text">+</text>
      </div>
    </div>

    <!-- 今日模式 -->
    <div if="{{ isInitialized && mode === 'today' }}" class="content">
      <div class="today-summary">
        <text class="week-number">{{ currentWeek > 0 ? '第' + currentWeek + '周' : '学期未开始' }}</text>
        <text class="summary-text"> · {{ todayTitle }}</text>
      </div>
      <list class="course-list" bounces="true">
        <list-item for="{{ todayCourses }}" class="timeline-item" type="todayCourse">
          <div class="timeline-time">
            <text class="time-text {{ $item.status === 'finished' ? 'text-gray' : ($item.status === 'ongoing' ? 'text-green' : 'text-blue') }}">{{ $item.startTime }}</text>
          </div>
          <div class="timeline-dot {{ $item.status === 'finished' ? 'dot-gray' : ($item.status === 'ongoing' ? 'dot-green' : 'dot-blue') }}"></div>
          <div class="timeline-line {{ $item.status === 'finished' ? 'line-gray' : '' }}"></div>
          <div class="timeline-card {{ $item.status === 'ongoing' ? 'card-green' : '' }}" onclick="goToDetail($item.id, 'today')">
            <marquee id="today-marquee-{{$idx}}" class="card-marquee {{ $item.status === 'finished' ? 'text-gray' : '' }}" scrollamount="64" loop="-1" text-offset="50">
              {{ $item.name }} {{ $item.classroom }} · {{ $item.teacher }}{{ $item.status === 'ongoing' ? ' 正在进行 · 剩余' + $item.remainingMin + '分钟' : ($item.status === 'finished' ? ' 已结束' : '') }}
            </marquee>
          </div>
        </list-item>
        <list-item if="{{ todayCourses.length === 0 }}" type="todayEmpty" class="empty-item">
          <text class="empty-text">今日无课</text>
        </list-item>
        <list-item type="todaySafe" class="safe-space-item"></list-item>
      </list>
    </div>

    <!-- 本周模式 -->
    <div if="{{ isInitialized && mode === 'week' }}" class="content">
      <!-- 周次选择器 -->
      <div class="week-selector-wrap">
        <div class="week-selector">
          <div class="week-arrow {{ selectedWeek <= 1 ? 'arrow-disabled' : '' }}" onclick="previousWeek">
            <text class="arrow-text">‹</text>
          </div>
          <div class="week-center">
            <text class="week-number">{{ selectedWeek > 0 ? '第' + selectedWeek + '周' : '学期未开始' }}</text>
            <text if="{{ selectedWeek === currentWeek && currentWeek > 0 }}" class="current-mark">本周</text>
          </div>
          <div class="week-arrow {{ selectedWeek >= 16 ? 'arrow-disabled' : '' }}" onclick="nextWeek">
            <text class="arrow-text">›</text>
          </div>
        </div>
      </div>

      <!-- 星期选择器 -->
      <div class="day-selector">
        <div class="month-label">
          <text class="month-text">{{ displayMonth }}月</text>
        </div>
        <div for="{{ weekDays }}" class="day-btn {{ selectedDay === $item.value ? 'day-active' : '' }}" onclick="selectDay($item.value)">
          <text class="day-text {{ selectedDay === $item.value ? 'day-text-active' : '' }}">{{ $item.label }}</text>
          <text class="day-date {{ selectedDay === $item.value ? 'day-date-active' : '' }}">{{ $item.date }}</text>
        </div>
      </div>

      <div class="week-summary">
        <text class="week-summary-text">{{ selectedWeek > 0 ? '第' + selectedWeek + '周' : '学期未开始' }} · {{ weekDayTitle }} · {{ weekCourses.length }}节课</text>
      </div>

      <list class="course-list" bounces="true">
        <list-item for="{{ weekCourses }}" class="week-item" type="weekCourse" onclick="goToDetail($item.id, 'week')">
          <text class="week-time text-blue">{{ $item.startTime }}</text>
          <text class="week-name">{{ $item.name }}</text>
          <text class="week-location">{{ $item.classroom }}</text>
        </list-item>
        <list-item if="{{ weekCourses.length === 0 }}" type="weekEmpty" class="empty-item">
          <text class="empty-text">该日无课</text>
        </list-item>
        <list-item type="weekSafe" class="safe-space-item"></list-item>
      </list>
    </div>

    <!-- 全部模式 -->
    <div if="{{ isInitialized && mode === 'all' }}" class="content">
      <!-- 星期选择器 -->
      <div class="day-selector">
        <div for="{{ weekDays }}" class="day-btn {{ selectedDay === $item.value ? 'day-active' : '' }}" onclick="selectDay($item.value)">
          <text class="day-text {{ selectedDay === $item.value ? 'day-text-active' : '' }}">{{ $item.label }}</text>
        </div>
      </div>

      <text class="sub-title">全部课程 · {{ allDayTitle }}</text>

      <list class="course-list" bounces="true">
        <list-item for="{{ allCourses }}" class="week-item" type="allCourse" onclick="goToDetail($item.id, 'all')">
          <div class="all-item-info">
            <text class="week-time text-blue">{{ $item.startTime }}</text>
            <text class="week-name">{{ $item.name }}</text>
            <text class="week-location">{{ $item.classroom }}</text>
          </div>
          <text class="week-tag">{{ $item.weeksText }}</text>
        </list-item>
        <list-item if="{{ allCourses.length === 0 }}" type="allEmpty" class="empty-item">
          <text class="empty-text">该日无课</text>
        </list-item>
        <list-item type="allSafe" class="safe-space-item"></list-item>
      </list>
    </div>
  </div>
</template>

