<template>
  <div class="page">
    <scroll class="detail-scroll" scroll-y="true" bounces="true">
      <div if="{{ exam }}" class="content">
        <!-- 课程名称 -->
        <text class="exam-course">{{ exam.course }}</text>

        <!-- 日期信息 -->
        <div class="info-row">
          <text class="info-label">日期</text>
          <text class="info-value">{{ examDateText }}</text>
        </div>

        <!-- 时间信息 -->
        <div class="time-section">
          <text class="time-value">{{ exam.startTime }}</text>
          <text class="time-arrow">→</text>
          <text class="time-value">{{ exam.endTime }}</text>
        </div>

        <!-- 考场信息 -->
        <div class="info-row">
          <text class="info-label">考场</text>
          <text class="info-value">{{ exam.classroom }}</text>
        </div>

        <!-- 倒计时 -->
        <div if="{{ !isFinished }}" class="countdown-section">
          <text class="countdown-text text-red">{{ countdownText }}</text>
        </div>

        <div if="{{ isFinished }}" class="countdown-section">
          <text class="countdown-text text-gray">已结束</text>
        </div>

        <!-- 删除区域（仅用户添加的考试显示） -->
        <div if="{{ canDelete }}" class="delete-section">
          <div if="{{ !deleteConfirming }}" class="delete-btn" onclick="onDeleteClick">
            <text class="delete-btn-text">删除考试</text>
          </div>
          <div if="{{ deleteConfirming }}" class="delete-confirm">
            <text class="delete-confirm-text">确定删除这场考试？</text>
            <div class="delete-btns">
              <div class="cancel-btn" onclick="onCancelDelete">
                <text class="cancel-btn-text">取消</text>
              </div>
              <div class="confirm-btn" onclick="onConfirmDelete">
                <text class="confirm-btn-text">确认删除</text>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div if="{{ !exam }}" class="empty">
        <text class="empty-text">考试不存在</text>
      </div>

      <div class="bottom-safe-space"></div>
    </scroll>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 466px;
  height: 466px;
  padding-top: 45px;
}

