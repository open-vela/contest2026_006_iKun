  width: 380px;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.exam-course {
  font-size: 34px;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 25px;
}

.info-row {
  flex-direction: row;
  width: 380px;
  margin-bottom: 15px;
  padding: 15px 20px;
  background-color: #171717;
  border-radius: 20px;
}

.info-label {
  font-size: 16px;
  color: #8F8F8F;
  width: 60px;
}

.info-value {
  font-size: 20px;
  color: #FFFFFF;
  flex: 1;
}

.time-section {
  flex-direction: row;
  align-items: center;
  margin-bottom: 25px;
}

.time-value {
  font-size: 48px;
  font-weight: 700;
  color: #FFFFFF;
}

.time-arrow {
  font-size: 32px;
  color: #FF6B6B;
  margin: 0 20px;
}

.countdown-section {
  width: 380px;
  flex-direction: column;
  align-items: center;
  margin-top: 25px;
  padding: 20px;
  background-color: #171717;
  border-radius: 22px;
}

.countdown-text {
  font-size: 24px;
  font-weight: 700;
}

.text-red {
  color: #FF6B6B;
}

.text-gray {
  color: #666666;
}

.delete-section {
  width: 380px;
  margin-top: 25px;
  flex-direction: column;
  align-items: center;
}

.delete-btn {
  width: 380px;
  height: 50px;
  border-radius: 25px;
  background-color: #FF6B6B;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.delete-btn-text {
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
}

.delete-confirm {
  width: 380px;
  flex-direction: column;
  align-items: center;
}

.delete-confirm-text {
  font-size: 16px;
  color: #FF6B6B;
  margin-bottom: 15px;
}

.delete-btns {
  flex-direction: row;
  justify-content: space-between;
  width: 380px;
}

.cancel-btn {
  width: 175px;
  height: 50px;
  border-radius: 25px;
  background-color: #2B2B2B;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cancel-btn-text {
  font-size: 16px;
  font-weight: 600;
  color: #FFFFFF;
}

.confirm-btn {
  width: 175px;
  height: 50px;
  border-radius: 25px;
  background-color: #FF6B6B;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.confirm-btn-text {
  font-size: 16px;
  font-weight: 600;
  color: #FFFFFF;
}

.bottom-safe-space {
  height: 80px;
  flex-shrink: 0;
}

.empty {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200px;
}

.empty-text {
  font-size: 20px;
  color: #666666;
}
</style>

<script>
import router from '@system.router'
import { getExams, ensureStorageReady, refreshExamsFromStorage, isUserCreatedExam, deleteExam } from '../../common/storage'
import { getExamCountdown, formatExamDate } from '../../common/exam'
import { getNow, parseDateTime } from '../../common/time'

export default {
  protected: {
    examId: ''
  },

  private: {
    exam: null,
    examDateText: '',
    countdownText: '',
    isFinished: false,
    canDelete: false,
    deleteConfirming: false,
    deleting: false
  },

  onInit() {
    ensureStorageReady()
      .then(() => refreshExamsFromStorage())
      .then(() => {
        this.loadExam()
      })
      .catch((err) => {
        console.error('Failed to initialize storage:', err)
        this.loadExam()
      })
  },

  loadExam() {
    const now = getNow()

    // 从统一缓存中查找考试
    this.exam = getExams().find(e => e.id === this.examId)

    if (this.exam) {
      this.examDateText = formatExamDate(this.exam)
      this.canDelete = isUserCreatedExam(this.examId)

      const countdown = getExamCountdown(this.exam, now)
      if (countdown.isFinished) {
        this.isFinished = true
        this.countdownText = '已结束'
      } else {
        this.isFinished = false
        this.countdownText = `还有 ${countdown.value} ${countdown.unit}`
      }
    }
  },

  onDeleteClick() {
    this.deleteConfirming = true
  },

  onCancelDelete() {
    this.deleteConfirming = false
  },

  onConfirmDelete() {
    if (this.deleting) return

    this.deleting = true
    deleteExam(this.examId)
      .then(() => {
        console.log('Exam deleted successfully')
        router.back()
      })
      .catch((err) => {
        console.error('Failed to delete exam:', err)
        this.deleting = false
        this.deleteConfirming = false
      })
  },

  onBackPress() {
    if (this.deleteConfirming) {
      this.deleteConfirming = false
      return true
    }
    return false
  }
}
</script>
