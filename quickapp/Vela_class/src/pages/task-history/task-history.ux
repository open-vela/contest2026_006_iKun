  width: 380px;
  height: 80px;
  flex-shrink: 0;
}
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { getHistoryTasks } from '../../common/task'
import { getTaskHistoryDays, ensureStorageReady, refreshTasksFromStorage, refreshTaskHistoryDaysFromStorage, syncMockDataSetting, clearHistoryTasks } from '../../common/storage'
import { getNow, parseDateTime } from '../../common/time'

export default {
  private: {
    isInitialized: false,
    taskList: [],
    historyDays: 15,
    clearConfirming: false,
    clearing: false,
    selectMode: false,
    selectedIds: [],
    deleteConfirming: false
  },

  onInit() {
    ensureStorageReady()
      .then(() => syncMockDataSetting())
      .then(() => Promise.all([
        refreshTasksFromStorage(),
        refreshTaskHistoryDaysFromStorage()
      ]))
      .then(() => {
        this.historyDays = getTaskHistoryDays()
        this.loadHistoryTasks()
        this.isInitialized = true
      })
      .catch((err) => {
        console.error('Failed to initialize storage:', err)
        this.historyDays = getTaskHistoryDays()
        this.loadHistoryTasks()
        this.isInitialized = true
      })
  },

  onShow() {
    if (!this.isInitialized) return

    ensureStorageReady()
      .then(() => syncMockDataSetting())
      .then(() => Promise.all([
        refreshTasksFromStorage(),
        refreshTaskHistoryDaysFromStorage()
      ]))
      .then(() => {
        this.historyDays = getTaskHistoryDays()
        this.loadHistoryTasks()
      })
      .catch((err) => {
        console.error('Failed to refresh history tasks:', err)
        this.loadHistoryTasks()
      })
  },

  loadHistoryTasks() {
    const now = getNow()
    const tasks = getHistoryTasks(now, this.historyDays)

    this.taskList = tasks.map(t => ({
      ...t,
      deadlineText: this.formatDate(t.deadline),
      finishedText: this.formatFinishedTime(t.finishedAt || t.deadline)
    }))
  },

  formatDate(deadline) {
    const date = parseDateTime(deadline)
    if (!date) return ''
    const month = date.getMonth() + 1
    const day = date.getDate()
    const hours = String(date.getHours()).padStart(2, '0')
    const minutes = String(date.getMinutes()).padStart(2, '0')
    return `${month}月${day}日 ${hours}:${minutes}`
  },

  formatFinishedTime(finishedAt) {
    const date = parseDateTime(finishedAt)
    if (!date) return ''
    const month = date.getMonth() + 1
    const day = date.getDate()
    return `${month}月${day}日完成`
  },

  goToDetail(taskId) {
    router.push({
      uri: '/pages/task-detail',
      params: {
        taskId: taskId
      }
    })
  },

  onTaskItemClick(taskId) {
    if (this.selectMode) {
      this.toggleSelect(taskId)
    } else {
      this.goToDetail(taskId)
    }
  },

  onClearClick() {
    this.clearConfirming = true
  },

  onCancelClear() {
    this.clearConfirming = false
  },

  onConfirmClear() {
    if (this.clearing) return

    this.clearing = true
    const allTaskIds = this.taskList.map(t => t.id)

    if (allTaskIds.length === 0) {
      this.clearing = false
      this.clearConfirming = false
      prompt.showToast({
        message: '没有可清除的待办',
        duration: 2000
      })
      return
    }

    clearHistoryTasks(allTaskIds)
      .then(() => {
        this.clearing = false
        this.clearConfirming = false
        this.loadHistoryTasks()
        prompt.showToast({
          message: '已清除',
          duration: 2000
        })
      })
      .catch(() => {
        this.clearing = false
        this.clearConfirming = false
        prompt.showToast({
          message: '清除失败',
          duration: 2000
        })
      })
  },

  onBackPress() {
    if (this.deleteConfirming) {
      this.deleteConfirming = false
      return true
    }
    if (this.selectMode) {
      this.onCancelManage()
      return true
    }
    if (this.clearConfirming) {
      this.clearConfirming = false
      return true
    }
    return false
  },

  onManageClick() {
    this.selectMode = true
    this.selectedIds = []
  },

  onCancelManage() {
    this.selectMode = false
    this.selectedIds = []
    this.deleteConfirming = false
  },

  toggleSelect(taskId) {
    const index = this.selectedIds.indexOf(taskId)
    const newIds = [...this.selectedIds]
    if (index !== -1) {
      newIds.splice(index, 1)
    } else {
      newIds.push(taskId)
    }
    this.selectedIds = newIds
  },

  onSelectAll() {
    const allTaskIds = this.taskList.map(t => t.id)

    if (this.selectedIds.length === allTaskIds.length) {
      this.selectedIds = []
    } else {
      this.selectedIds = allTaskIds
    }
  },

  onDeleteClick() {
    this.deleteConfirming = true
  },

  onCancelDelete() {
    this.deleteConfirming = false
  },

  onConfirmDelete() {
    if (this.clearing) return

    if (this.selectedIds.length === 0) {
      this.deleteConfirming = false
      prompt.showToast({
        message: '请先选择待办',
        duration: 2000
      })
      return
    }

    this.clearing = true
    clearHistoryTasks(this.selectedIds)
      .then(() => {
        this.clearing = false
        this.deleteConfirming = false
        this.selectMode = false
        const count = this.selectedIds.length
        this.selectedIds = []
        this.loadHistoryTasks()
        prompt.showToast({
          message: `已删除${count}项`,
          duration: 2000
        })
      })
      .catch(() => {
        this.clearing = false
        this.deleteConfirming = false
        prompt.showToast({
          message: '删除失败',
          duration: 2000
        })
      })
  }
}
</script>
