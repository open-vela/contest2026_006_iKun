<template>
  <div class="page">
    <!-- 顶部标题 -->
    <div class="header">
      <text class="title">历史待办</text>
    </div>

    <!-- 加载状态 -->
    <div if="{{ !isInitialized }}" class="loading-container">
      <text class="loading-text">加载中...</text>
    </div>

    <!-- 操作栏 -->
    <div if="{{ isInitialized }}" class="action-row">
      <!-- 正常模式 -->
      <div if="{{ !selectMode }}" class="action-normal">
        <text class="action-text">已归档 · {{ taskList.length }}项</text>
        <div if="{{ !clearConfirming }}" class="action-btns">
          <div class="manage-btn" onclick="onManageClick">
            <text class="manage-btn-text">管理</text>
          </div>
          <div class="clear-btn" onclick="onClearClick">
            <text class="clear-btn-text">清除</text>
          </div>
        </div>
        <div if="{{ clearConfirming }}" class="confirm-row">
          <text class="confirm-text">确定清除？</text>
          <div class="cancel-btn" onclick="onCancelClear">
            <text class="cancel-btn-text">取消</text>
          </div>
          <div class="confirm-btn" onclick="onConfirmClear">
            <text class="confirm-btn-text">确认</text>
          </div>
        </div>
      </div>

      <!-- 选择模式 -->
      <div if="{{ selectMode }}" class="action-select">
        <text class="selected-text">已选 {{ selectedIds.length }} 项</text>
        <div class="select-btns">
          <div class="select-all-btn" onclick="onSelectAll">
            <text class="select-all-text">全选</text>
          </div>
          <div if="{{ !deleteConfirming }}" class="delete-btn" onclick="onDeleteClick">
            <text class="delete-btn-text">删除</text>
          </div>
          <div if="{{ deleteConfirming }}" class="delete-confirm-row">
            <text class="confirm-text">确定删除？</text>
            <div class="cancel-btn" onclick="onCancelDelete">
              <text class="cancel-btn-text">取消</text>
            </div>
            <div class="confirm-btn" onclick="onConfirmDelete">
              <text class="confirm-btn-text">确认</text>
            </div>
          </div>
          <div class="done-btn" onclick="onCancelManage">
            <text class="done-btn-text">完成</text>
          </div>
        </div>
      </div>
    </div>

    <!-- 可滚动区域 -->
    <scroll if="{{ isInitialized }}" class="task-scroll" scroll-y="true" bounces="true">

      <!-- 历史待办列表 -->
      <div if="{{ taskList.length > 0 }}" class="task-list">
        <div for="{{ taskList }}" class="task-item {{ selectMode && selectedIds.indexOf($item.id) !== -1 ? 'task-item-selected' : '' }}" onclick="onTaskItemClick($item.id)">
          <div if="{{ selectMode }}" class="check-mark">
            <text class="check-icon {{ selectedIds.indexOf($item.id) !== -1 ? 'check-active' : '' }}">{{ selectedIds.indexOf($item.id) !== -1 ? '●' : '○' }}</text>
          </div>
          <div class="task-info">
            <text class="task-name">{{ $item.title }}</text>
            <text class="task-deadline">截止：{{ $item.deadlineText }}</text>
            <text class="task-finished">完成：{{ $item.finishedText }}</text>
          </div>
        </div>
      </div>

      <!-- 空状态 -->
      <div if="{{ taskList.length === 0 }}" class="empty">
        <text class="empty-text">暂无历史待办</text>
      </div>

      <!-- 底部安全空间 -->
      <div class="bottom-safe-space"></div>

    </scroll>
  </div>
</template>

<style>
