<template>
  <div class="page">
    <!-- 顶部标题 -->
    <div class="header">
      <text class="title">考试</text>
    </div>

    <!-- 可滚动区域 -->
    <scroll class="exam-scroll" scroll-y="true" bounces="true">

      <!-- 考试列表 -->
      <div if="{{ examList.length > 0 }}" class="exam-list">
        <div for="{{ examList }}" class="exam-item">
          <div class="exam-main">
            <text class="exam-name">{{ $item.course }}</text>
            <text class="exam-time">{{ $item.dateText }} · {{ $item.startTime }}</text>
            <text class="exam-place">{{ $item.classroom }}</text>
          </div>
          <div class="exam-countdown-badge">
            <text class="badge-value">{{ $item.countdown.value }}</text>
            <text class="badge-unit">{{ $item.countdown.unit }}</text>
          </div>
        </div>
      </div>

      <!-- 空状态 -->
      <div if="{{ examList.length === 0 }}" class="empty">
        <text class="empty-text">暂无考试安排</text>
      </div>

      <!-- 底部安全空间 -->
      <div class="bottom-safe-space"></div>

    </scroll>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 466px;
  height: 466px;
  padding-top: 45px;
}

.header {
  margin-bottom: 20px;
}

.title {
  font-size: 24px;
  font-weight: 700;
  color: #FFFFFF;
}

.exam-scroll {
  width: 400px;
  height: 380px;
  flex-direction: column;
  align-items: center;
}

.exam-list {
  width: 380px;
  flex-direction: column;
  flex-shrink: 0;
}

.exam-item {
  flex-direction: row;
  align-items: center;
  background-color: #171717;
  border-radius: 20px;
  border: 1px solid rgba(255, 107, 107, 0.3);
  padding: 15px;
  margin-bottom: 10px;
  flex-shrink: 0;
  min-height: 80px;
}

.exam-main {
  flex: 1;
  flex-direction: column;
}

.exam-name {
  font-size: 20px;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 6px;
}

.exam-time {
  font-size: 15px;
  color: #CFCFCF;
  margin-bottom: 4px;
}

.exam-place {
  font-size: 14px;
  color: #8F8F8F;
}

.exam-countdown-badge {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 60px;
  border-radius: 18px;
  background-color: rgba(255, 107, 107, 0.15);
  flex-shrink: 0;
  margin-left: 10px;
}

.badge-value {
  font-size: 24px;
  font-weight: 700;
  color: #FF6B6B;
}

.badge-unit {
  font-size: 12px;
  color: #FF6B6B;
}

.empty {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100px;
  flex-shrink: 0;
}

.empty-text {
  font-size: 18px;
  color: #8F8F8F;
}

.bottom-safe-space {
  width: 380px;
  height: 80px;
  flex-shrink: 0;
}
</style>

<script>
import { getUpcomingExams, getExamCountdown, formatExamDate } from '../../common/exam'
import { getNow } from '../../common/time'
import { ensureStorageReady, refreshExamsFromStorage } from '../../common/storage'

const DEBUG_NOW = null

export default {
  private: {
    examList: []
  },

  onInit() {
    ensureStorageReady()
      .then(() => refreshExamsFromStorage())
      .then(() => {
        this.loadExams()
      })
      .catch((err) => {
        console.error('Failed to initialize storage on exam:', err)
        this.loadExams()
      })
  },

  onShow() {
    ensureStorageReady()
      .then(() => refreshExamsFromStorage())
      .then(() => {
        this.loadExams()
      })
      .catch((err) => {
        console.error('Failed to refresh exams:', err)
        this.loadExams()
      })
  },

  loadExams() {
    const now = getNow(DEBUG_NOW)

    // 获取所有即将到来的考试
    const exams = getUpcomingExams(now)
    this.examList = exams.map(e => ({
      ...e,
      dateText: formatExamDate(e).split(' · ')[0],
      countdown: getExamCountdown(e, now)
    }))
  }
}
</script>
