<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <!-- 顶部标题 -->
    <div class="header">
      <text class="title">添加待办</text>
    </div>

    <!-- 可滚动内容区域 -->
    <scroll class="form-scroll" scroll-y="true" bounces="true">
      <div class="content">
        <!-- 任务名称 -->
        <div class="form-group">
          <text class="label">任务名称</text>
          <div class="input-wrapper" @click="showKeyboard('title')">
            <text if="{{ !title }}" class="placeholder-text">请输入任务名称</text>
            <text class="input-text">{{ title }}</text>
          </div>
        </div>

        <!-- 关联课程 -->
        <div class="form-group">
          <text class="label">关联课程</text>
          <picker class="picker" type="text" range="{{ courseRange }}" selected="{{ selectedCourseIndex }}" onchange="onCourseChange">
          </picker>
        </div>

        <!-- 任务类型 -->
        <div class="form-group">
          <text class="label">任务类型</text>
          <picker class="picker" type="text" range="{{ typeRange }}" selected="{{ selectedTypeIndex }}" onchange="onTypeChange">
          </picker>
        </div>

        <!-- 截止日期 -->
        <div class="form-group">
          <text class="label">截止日期</text>
          <picker class="picker" type="text" range="{{ dateDisplayRange }}" selected="{{ selectedDateIndex }}" onchange="onDateChange">
          </picker>
        </div>

        <!-- 截止时间 -->
        <div class="form-group">
          <text class="label">截止时间</text>
          <picker class="picker" type="time" selected="{{ deadlineTime }}" onchange="onTimeChange">
          </picker>
        </div>

        <!-- 保存按钮 -->
        <div class="btn-save" @click="saveTask">
          <text class="btn-text">保存</text>
        </div>

        <div class="bottom-safe-space"></div>
      </div>
    </scroll>

    <!-- 输入法组件 -->
    <input-method
      hide="{{ keyboardHidden }}"
      screentype="circle"
      keyboardtype="QWERTY"
      maxlength="5"
      @complete="onComplete"
      @delete="onDelete"
    ></input-method>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 466px;
  height: 466px;
  padding-top: 35px;
}

.header {
  flex-direction: column;
  align-items: center;
  margin-bottom: 8px;
}

.title {
  font-size: 22px;
  font-weight: 700;
  color: #FFFFFF;
}

.form-scroll {
  width: 400px;
  height: 385px;
  flex-direction: column;
  align-items: center;
}

.content {
  width: 380px;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.form-group {
  width: 100%;
  flex-direction: column;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.label {
  font-size: 15px;
  color: #B0B0B0;
  margin-bottom: 6px;
  margin-left: 5px;
}

.picker {
  width: 100%;
  height: 52px;
  background-color: #1A1A1A;
  border-radius: 14px;
  color: #FFFFFF;
  font-size: 17px;
}

.input-wrapper {
  width: 100%;
  height: 52px;
  background-color: #1A1A1A;
  border-radius: 14px;
  flex-direction: row;
  align-items: center;
  padding: 0 18px;
}

.placeholder-text {
  font-size: 16px;
  color: #666666;
}

.input-text {
  font-size: 17px;
  color: #FFFFFF;
}

.btn-save {
  width: 380px;
  height: 50px;
  border-radius: 25px;
  background-color: #B57BFF;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 10px;
}

.btn-text {
  font-size: 16px;
  font-weight: 600;
  color: #FFFFFF;
}

.bottom-safe-space {
  height: 80px;
  flex-shrink: 0;
}
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { getCourses, addTask, ensureStorageReady } from '../../common/storage'
import { getNow, getWeekday } from '../../common/time'

export default {
  private: {
    title: '',
    courseRange: [],
    courseNames: [],
    selectedCourseIndex: 0,
    typeRange: ['实验', '作业', '报告', '其他'],
    typeValues: ['experiment', 'homework', 'report', 'other'],
    selectedTypeIndex: 0,
    dateDisplayRange: [],
    dateValueRange: [],
    selectedDateIndex: 0,
    deadlineTime: '23:59',
    keyboardHidden: true,
    currentInputField: ''
  },

  onInit() {
    ensureStorageReady().then(() => {
      this.initCourseRange()
      this.initDateRange()
    })
  },

  showError(message) {
    prompt.showToast({
      message: message,
      duration: 2000
    })
  },

  initCourseRange() {
    const courses = getCourses()
    this.courseRange = ['无关联课程', ...courses.map(c => c.name)]
    this.courseNames = ['', ...courses.map(c => c.name)]
  },

  initDateRange() {
    const now = getNow()
    const displayRange = []
    const valueRange = []

    for (let i = 0; i < 30; i++) {
      const date = new Date(now)
      date.setDate(date.getDate() + i)
      const month = date.getMonth() + 1
      const day = date.getDate()
      const weekday = getWeekday(date)

      if (i === 0) {
        displayRange.push(`今天 ${month}月${day}日`)
      } else if (i === 1) {
        displayRange.push(`明天 ${month}月${day}日`)
      } else {
        displayRange.push(`${month}月${day}日 ${weekday}`)
      }

      const year = date.getFullYear()
      const monthStr = String(month).padStart(2, '0')
      const dayStr = String(day).padStart(2, '0')
      valueRange.push(`${year}-${monthStr}-${dayStr}`)
    }

    this.dateDisplayRange = displayRange
    this.dateValueRange = valueRange
  },

  showKeyboard(field) {
    this.currentInputField = field
    this.keyboardHidden = false
  },

  onComplete(evt) {
    const content = evt.detail.content
    if (this.currentInputField === 'title') {
      this.title += content
    }
  },

  onDelete() {
    if (this.currentInputField === 'title' && this.title.length > 0) {
      this.title = this.title.slice(0, -1)
    }
  },

  onCourseChange(e) {
    this.selectedCourseIndex = e.newSelected
  },

  onTypeChange(e) {
    this.selectedTypeIndex = e.newSelected
  },

  onDateChange(e) {
    this.selectedDateIndex = e.newSelected
  },

  onTimeChange(e) {
    const hour = String(e.hour).padStart(2, '0')
    const minute = String(e.minute).padStart(2, '0')
    this.deadlineTime = `${hour}:${minute}`
  },

  saveTask() {
    if (!this.title) {
      this.showError('请输入任务名称')
      return
    }

    if (!this.deadlineTime) {
      this.showError('请选择截止时间')
      return
    }

    // 校验截止时间不能早于当前时间
    const deadlineDateStr = this.dateValueRange[this.selectedDateIndex]
    const deadlineDateTime = new Date(`${deadlineDateStr}T${this.deadlineTime}:00`)
    const now = getNow()

    if (deadlineDateTime <= now) {
      this.showError('截止时间不能早于当前时间')
      return
    }

    this.keyboardHidden = true

    const deadline = `${deadlineDateStr}T${this.deadlineTime}:00`

    const taskData = {
      title: this.title,
      course: this.courseNames[this.selectedCourseIndex],
      deadline: deadline,
      type: this.typeValues[this.selectedTypeIndex]
    }

    addTask(taskData)
      .then(() => {
        router.back()
      })
      .catch((err) => {
        this.showError('添加待办失败')
      })
  },

  onBackPress() {
    if (!this.keyboardHidden) {
      this.keyboardHidden = true
      return true
    }
    return false
  }
}
</script>
