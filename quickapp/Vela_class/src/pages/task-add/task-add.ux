<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <!-- 顶部标题 -->
    <div class="header">
      <text class="title">{{ isEdit ? '编辑待办' : '添加待办' }}</text>
    </div>

    <!-- 可滚动内容区域 -->
    <scroll id="formScroll" class="form-scroll" scroll-y="true" bounces="true">
      <div class="content">
        <!-- 任务名称 -->
        <div class="form-group">
          <text class="label">任务名称</text>
          <div class="input-wrapper" @click="onInputFocus('title')">
            <text if="{{ !title }}" class="placeholder-text">请输入任务名称</text>
            <text class="input-text">{{ title }}</text>
          </div>
        </div>

        <!-- 关联课程 -->
        <div class="form-group">
          <text class="label">关联课程</text>
          <picker class="picker" type="text" range="{{ courseRange }}" selected="{{ selectedCourseIndex }}" onchange="onCourseChange">
          </picker>
        </div>

        <!-- 任务类型 -->
        <div class="form-group">
          <text class="label">任务类型</text>
          <picker class="picker" type="text" range="{{ typeRange }}" selected="{{ selectedTypeIndex }}" onchange="onTypeChange">
          </picker>
        </div>

        <!-- 截止日期 -->
        <div class="form-group">
          <text class="label">截止日期</text>
          <picker class="picker" type="text" range="{{ dateDisplayRange }}" selected="{{ selectedDateIndex }}" onchange="onDateChange">
          </picker>
        </div>

        <!-- 截止时间 -->
        <div class="form-group">
          <text class="label">截止时间</text>
          <picker class="picker" type="time" selected="{{ deadlineTime }}" onchange="onTimeChange">
          </picker>
        </div>

        <!-- 保存按钮 -->
        <div class="btn-save" @click="saveTask">
          <text class="btn-text">保存</text>
        </div>

        <div class="bottom-safe-space"></div>
      </div>
    </scroll>

    <!-- 输入法组件 -->
    <input-method
      hide="{{ keyboardHidden }}"
      screentype="circle"
      keyboardtype="QWERTY"
      maxlength="20"
      @complete="onKeyboardInput"
      @delete="onKeyboardDelete"
    ></input-method>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 466px;
  height: 466px;
  padding-top: 35px;
}

.header {
  flex-direction: column;
  align-items: center;
  margin-bottom: 8px;
}

.title {
  font-size: 22px;
  font-weight: 700;
  color: #FFFFFF;
}

.form-scroll {
  width: 400px;
  height: 385px;
  flex-direction: column;
  align-items: center;
}

.content {
  width: 380px;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.form-group {
  width: 100%;
  flex-direction: column;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.label {
  font-size: 15px;
  color: #B0B0B0;
  margin-bottom: 6px;
  margin-left: 5px;
}

.picker {
  width: 100%;
  height: 52px;
  background-color: #1A1A1A;
  border-radius: 14px;
  color: #FFFFFF;
  font-size: 17px;
}

.input-wrapper {
  width: 100%;
  height: 52px;
  background-color: #1A1A1A;
  border-radius: 14px;
  flex-direction: row;
  align-items: center;
  padding: 0 18px;
}

.placeholder-text {
  font-size: 16px;
  color: #666666;
}

.input-text {
  font-size: 17px;
  color: #FFFFFF;
}

.btn-save {
  width: 380px;
  height: 50px;
  border-radius: 25px;
  background-color: #B57BFF;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 10px;
}

.btn-text {
  font-size: 16px;
  font-weight: 600;
  color: #FFFFFF;
}

.bottom-safe-space {
  height: 200px;
  flex-shrink: 0;
}
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { getCourses, getTasks, addTask, updateTask, ensureStorageReady } from '../../common/storage'
import { getNow, getWeekday } from '../../common/time'

export default {
  protected: {
    taskId: ''
  },

  private: {
    isEdit: false,
    title: '',
    courseRange: [],
    courseNames: [],
    selectedCourseIndex: 0,
    typeRange: ['实验', '作业', '报告', '其他'],
    typeValues: ['experiment', 'homework', 'report', 'other'],
    selectedTypeIndex: 0,
    dateDisplayRange: [],
    dateValueRange: [],
    selectedDateIndex: 1,
    deadlineTime: '23:59',
    keyboardHidden: true,
    currentInputField: ''
  },

  onInit() {
    if (this.taskId) {
      this.isEdit = true
      ensureStorageReady().then(() => {
        this.initCourseRange()
        this.initDateRange()
        const task = getTasks().find(t => t.id === this.taskId)
        if (task) {
          this.prefill(task)
        }
      })
    } else {
      ensureStorageReady().then(() => {
        this.initCourseRange()
        this.initDateRange()
      })
    }
  },

  prefill(task) {
    this.title = task.title || ''

    // 课程预填
    const courseIndex = this.courseNames.findIndex(c => c === task.course)
    if (courseIndex !== -1) {
      this.selectedCourseIndex = courseIndex
    } else {
      this.selectedCourseIndex = 0
    }

    // 类型预填
    const typeIndex = this.typeValues.findIndex(t => t === task.type)
    if (typeIndex !== -1) {
      this.selectedTypeIndex = typeIndex
    }

    // 日期和时间预填
    if (task.deadline) {
      const parts = task.deadline.split('T')
      if (parts.length === 2) {
        const dateStr = parts[0]
        const timeStr = parts[1].substring(0, 5)
        const dateIndex = this.dateValueRange.findIndex(d => d === dateStr)
        if (dateIndex !== -1) {
          this.selectedDateIndex = dateIndex
        } else {
          // 原日期超出范围时，插入到数组开头
          const date = parseDateTime(dateStr + 'T00:00:00')
          if (date) {
            const month = date.getMonth() + 1
            const day = date.getDate()
            const weekday = getWeekday(date)
            this.dateDisplayRange.unshift(`${month}月${day}日 ${weekday}`)
            this.dateValueRange.unshift(dateStr)
            this.selectedDateIndex = 0
          }
        }
        this.deadlineTime = timeStr
      }
    }
  },

  showError(message) {
    prompt.showToast({
      message: message,
      duration: 2000
    })
  },

  initCourseRange() {
    const courses = getCourses()
    this.courseRange = ['无关联课程', ...courses.map(c => c.name)]
    this.courseNames = ['', ...courses.map(c => c.name)]
  },

  initDateRange() {
    const now = getNow()
    const displayRange = []
    const valueRange = []

    for (let i = 0; i < 180; i++) {
      const date = new Date(now)
      date.setDate(date.getDate() + i)
      const month = date.getMonth() + 1
      const day = date.getDate()
      const weekday = getWeekday(date)

      if (i === 0) {
        displayRange.push(`今天 ${month}月${day}日`)
      } else if (i === 1) {
        displayRange.push(`明天 ${month}月${day}日`)
      } else {
        displayRange.push(`${month}月${day}日 ${weekday}`)
      }

      const year = date.getFullYear()
      const monthStr = String(month).padStart(2, '0')
      const dayStr = String(day).padStart(2, '0')
      valueRange.push(`${year}-${monthStr}-${dayStr}`)
    }

    this.dateDisplayRange = displayRange
    this.dateValueRange = valueRange
  },

  // 点击输入框时记录当前字段并打开键盘
  onInputFocus(field) {
    this.currentInputField = field
    this.keyboardHidden = false
  },

  // 键盘输入事件
  onKeyboardInput(evt) {
    const content = (evt && evt.detail && evt.detail.content) || ''
    if (this.currentInputField === 'title') {
      this.title += content
    }
  },

  // 键盘删除事件
  onKeyboardDelete() {
    if (this.currentInputField === 'title' && this.title.length > 0) {
      this.title = this.title.slice(0, -1)
    }
  },

  onCourseChange(e) {
    this.selectedCourseIndex = e.newSelected
  },

  onTypeChange(e) {
    this.selectedTypeIndex = e.newSelected
  },

  onDateChange(e) {
    this.selectedDateIndex = e.newSelected
  },

  onTimeChange(e) {
    const hour = String(e.hour).padStart(2, '0')
    const minute = String(e.minute).padStart(2, '0')
    this.deadlineTime = `${hour}:${minute}`
  },

  saveTask() {
    if (!this.title) {
      this.showError('请输入任务名称')
      return
    }

    if (!this.deadlineTime) {
      this.showError('请选择截止时间')
      return
    }

    // 校验截止时间不能早于当前时间
    const deadlineDateStr = this.dateValueRange[this.selectedDateIndex]
    const deadlineDateTime = new Date(`${deadlineDateStr}T${this.deadlineTime}:00`)
    const now = getNow()

    if (deadlineDateTime <= now) {
      this.showError('截止时间不能早于当前时间')
      return
    }

    const deadline = `${deadlineDateStr}T${this.deadlineTime}:00`

    const taskData = {
      title: this.title,
      course: this.courseNames[this.selectedCourseIndex],
      deadline: deadline,
      type: this.typeValues[this.selectedTypeIndex]
    }

    ensureStorageReady()
      .then(() => this.taskId ? updateTask(this.taskId, taskData) : addTask(taskData))
      .then(() => {
        router.back()
      })
      .catch((err) => {
        this.showError('保存失败')
      })
  },

  onBackPress() {
    if (!this.keyboardHidden) {
      this.keyboardHidden = true
      this.currentInputField = ''
      return true
    }
    return false
  }
}
</script>
