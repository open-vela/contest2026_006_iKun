  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.weekday-btn {
  width: 48px;
  height: 40px;
  border-radius: 10px;
  background-color: #171717;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

