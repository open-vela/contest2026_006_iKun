<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <!-- 顶部标题 -->
    <div class="header">
      <text class="title">添加课程</text>
      <text class="step-text">步骤 {{ step }}/3</text>
    </div>

    <!-- 可滚动内容区域 -->
    <scroll id="formScroll" class="form-scroll" scroll-y="true" bounces="true">
      <!-- 步骤1：基本信息 -->
      <div if="{{ step === 1 }}" class="content">
        <div class="form-group">
          <text class="label">课程名称</text>
          <div class="input-wrapper" @click="showKeyboard('name')">
            <text if="{{ !name }}" class="placeholder-text">请输入课程名称</text>
            <text class="input-text">{{ name }}</text>
          </div>
        </div>
        <div class="form-group">
          <text class="label">教师</text>
          <div class="input-wrapper" @click="showKeyboard('teacher')">
            <text if="{{ !teacher }}" class="placeholder-text">请输入教师姓名</text>
            <text class="input-text">{{ teacher }}</text>
          </div>
        </div>
        <div class="form-group">
          <text class="label">教室</text>
          <div class="input-wrapper" @click="showKeyboard('classroom')">
            <text if="{{ !classroom }}" class="placeholder-text">请输入教室</text>
            <text class="input-text">{{ classroom }}</text>
          </div>
        </div>
        <div class="btn-next" @click="nextStep">
          <text class="btn-text">下一步</text>
        </div>
        <!-- 底部安全空间 -->
        <div class="bottom-safe-space"></div>
      </div>

      <!-- 步骤2：时间 -->
      <div if="{{ step === 2 }}" class="content">
        <div class="form-group">
          <text class="label">星期</text>
          <div class="weekday-selector">
            <div for="{{ weekdays }}" class="weekday-btn {{ selectedWeekday === $item.value ? 'weekday-active' : '' }}" @click="selectWeekday($item.value)">
              <text class="weekday-text">{{ $item.label }}</text>
            </div>
          </div>
        </div>
        <div class="form-group">
          <text class="label">开始时间</text>
          <div class="time-selector">
            <div class="time-btn" @click="openStartPicker">
              <text class="time-text">{{ startTime || '选择时间' }}</text>
            </div>
          </div>
        </div>
        <div class="form-group">
          <text class="label">结束时间</text>
          <div class="time-selector">
            <div class="time-btn" @click="openEndPicker">
              <text class="time-text">{{ endTime || '选择时间' }}</text>
            </div>
          </div>
        </div>
        <div class="btn-row">
          <div class="btn-back" @click="prevStep">
            <text class="btn-text">上一步</text>
          </div>
          <div class="btn-next" @click="nextStep">
            <text class="btn-text">下一步</text>
          </div>
        </div>
        <!-- 底部安全空间 -->
        <div class="bottom-safe-space"></div>
      </div>

      <!-- 步骤3：周次 -->
      <div if="{{ step === 3 }}" class="content">
        <div class="form-group">
          <text class="label">上课周次</text>
          <div class="week-type-selector">
            <div class="week-type-btn {{ weekType === 'all' ? 'week-type-active' : '' }}" @click="selectWeekType('all')">
              <text class="week-type-text">全周</text>
            </div>
            <div class="week-type-btn {{ weekType === 'odd' ? 'week-type-active' : '' }}" @click="selectWeekType('odd')">
              <text class="week-type-text">单周</text>
            </div>
            <div class="week-type-btn {{ weekType === 'even' ? 'week-type-active' : '' }}" @click="selectWeekType('even')">
              <text class="week-type-text">双周</text>
            </div>
            <div class="week-type-btn {{ weekType === 'custom' ? 'week-type-active' : '' }}" @click="selectWeekType('custom')">
              <text class="week-type-text">自定义</text>
            </div>
          </div>
        </div>
        <div if="{{ weekType === 'custom' }}" class="form-group">
          <text class="label">选择周次（点击切换）</text>
          <div class="weeks-grid">
            <div for="{{ weekOptions }}" class="week-btn {{ $item.selected ? 'week-selected' : '' }}" @click="toggleWeek($item.value)">
              <text class="week-num">{{ $item.value }}</text>
            </div>
          </div>
        </div>
        <div class="form-group">
          <text class="label">已选周次：{{ weeksText }}</text>
        </div>
        <div class="btn-row">
          <div class="btn-back" @click="prevStep">
            <text class="btn-text">上一步</text>
          </div>
          <div class="btn-save" @click="saveCourse">
            <text class="btn-text">保存</text>
          </div>
        </div>
        <!-- 底部安全空间 -->
        <div class="bottom-safe-space"></div>
      </div>
    </scroll>

    <!-- 时间选择器弹窗 -->
    <div if="{{ showStartPicker || showEndPicker }}" class="picker-mask">
      <div class="picker-popup">
        <text class="picker-title">选择时间</text>
        <scroll class="time-scroll" scroll-y="true">
          <div class="time-options">
            <div for="{{ timeOptions }}" class="time-option" onclick="selectTime($item)">
              <text class="time-option-text">{{ $item }}</text>
            </div>
          </div>
        </scroll>
        <div class="picker-btn" onclick="closePicker">
          <text class="picker-btn-text">取消</text>
        </div>
      </div>
    </div>

    <!-- 输入法组件 -->
    <input-method
      hide="{{ keyboardHidden }}"
      screentype="circle"
      keyboardtype="QWERTY"
      maxlength="5"
      @complete="onComplete"
      @delete="onDelete"
    ></input-method>
  </div>
</template>

<style>
