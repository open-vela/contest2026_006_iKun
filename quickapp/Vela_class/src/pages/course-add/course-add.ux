  font-size: 14px;
  color: #FFFFFF;
}

.weeks-grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
}

.week-btn {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background-color: #171717;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 8px;
  margin-bottom: 8px;
}

