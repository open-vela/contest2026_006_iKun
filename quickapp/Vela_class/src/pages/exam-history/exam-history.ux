  flex-shrink: 0;
}
</style>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import { getHistoryExams, formatExamDate } from '../../common/exam'
import { getNow } from '../../common/time'
import { ensureStorageReady, refreshExamsFromStorage, syncMockDataSetting, clearHistoryExams } from '../../common/storage'

export default {
  private: {
    isInitialized: false,
    examList: [],
    hasUserExams: false,
    clearConfirming: false,
    clearing: false,
    selectMode: false,
    selectedIds: [],
    deleteConfirming: false
  },

  onInit() {
    ensureStorageReady()
      .then(() => syncMockDataSetting())
      .then(() => refreshExamsFromStorage())
      .then(() => {
        this.loadExams()
        this.isInitialized = true
      })
      .catch((err) => {
        console.error('Failed to initialize storage on exam-history:', err)
        this.loadExams()
        this.isInitialized = true
      })
  },

  onShow() {
    if (!this.isInitialized) return
    
    ensureStorageReady()
      .then(() => syncMockDataSetting())
      .then(() => refreshExamsFromStorage())
      .then(() => {
        this.loadExams()
      })
      .catch((err) => {
        console.error('Failed to refresh history exams:', err)
        this.loadExams()
      })
  },

  loadExams() {
    const now = getNow()

    // 获取历史考试
    const exams = getHistoryExams(now)
    this.examList = exams.map(e => ({
      ...e,
      dateText: formatExamDate(e).split(' · ')[0]
    }))

    // 检查是否有考试
    this.hasUserExams = this.examList.length > 0
  },

  goToDetail(examId) {
    router.push({
      uri: '/pages/exam-detail',
      params: {
        examId: examId
      }
    })
  },

  onExamItemClick(examId) {
    if (this.selectMode) {
      this.toggleSelect(examId)
    } else {
      this.goToDetail(examId)
    }
  },

  onClearClick() {
    this.clearConfirming = true
  },

  onCancelClear() {
    this.clearConfirming = false
  },

  onConfirmClear() {
    if (this.clearing) return

    this.clearing = true
    const allExamIds = this.examList.map(e => e.id)

    if (allExamIds.length === 0) {
      this.clearing = false
      this.clearConfirming = false
      prompt.showToast({
        message: '没有可清除的考试',
        duration: 2000
      })
      return
    }

    clearHistoryExams(allExamIds)
      .then(() => {
        this.clearing = false
        this.clearConfirming = false
        this.loadExams()
        prompt.showToast({
          message: '已清除',
          duration: 2000
        })
      })
      .catch(() => {
        this.clearing = false
        this.clearConfirming = false
        prompt.showToast({
          message: '清除失败',
          duration: 2000
        })
      })
  },

  onBackPress() {
    if (this.deleteConfirming) {
      this.deleteConfirming = false
      return true
    }
    if (this.selectMode) {
      this.onCancelManage()
      return true
    }
    if (this.clearConfirming) {
      this.clearConfirming = false
      return true
    }
    return false
  },

  isUserExam(examId) {
    return true
  },

  onManageClick() {
    this.selectMode = true
    this.selectedIds = []
  },

  onCancelManage() {
    this.selectMode = false
    this.selectedIds = []
    this.deleteConfirming = false
  },

  toggleSelect(examId) {
    const index = this.selectedIds.indexOf(examId)
    if (index !== -1) {
      this.selectedIds.splice(index, 1)
    } else {
      this.selectedIds.push(examId)
    }
  },

  onSelectAll() {
    const allExamIds = this.examList.map(e => e.id)

    if (this.selectedIds.length === allExamIds.length) {
      this.selectedIds = []
    } else {
      this.selectedIds = allExamIds
    }
  },

  onDeleteClick() {
    this.deleteConfirming = true
  },

  onCancelDelete() {
    this.deleteConfirming = false
  },

  onConfirmDelete() {
    if (this.clearing) return

    if (this.selectedIds.length === 0) {
      this.deleteConfirming = false
      prompt.showToast({
        message: '请先选择考试',
        duration: 2000
      })
      return
    }

    this.clearing = true
    clearHistoryExams(this.selectedIds)
      .then(() => {
        this.clearing = false
        this.deleteConfirming = false
        this.selectMode = false
        const count = this.selectedIds.length
        this.selectedIds = []
        this.loadExams()
        prompt.showToast({
          message: `已删除${count}项`,
          duration: 2000
        })
      })
      .catch(() => {
        this.clearing = false
        this.deleteConfirming = false
        prompt.showToast({
          message: '删除失败',
          duration: 2000
        })
      })
  }
}
</script>
