<template>
  <div class="page">
    <!-- 顶部时间 -->
    <div class="header">
      <text class="time">{{ currentTime }}</text>
      <text class="date">{{ currentDate }}</text>
    </div>

    <!-- 主卡片 -->
    <div class="main-card {{ mainCardClass }}" onclick="goToCourseDetail">
      <!-- 状态1: 下一节课 -->
      <div if="{{ status === 'next' }}" class="card-content">
        <text class="status-label status-blue">下一节课</text>
        <text class="course-name">{{ nextCourse.name }}</text>
        <text class="time-info">{{ nextCourse.startTime }} 开始</text>
        <text class="location-info">{{ nextCourse.classroom }} · {{ nextCourse.teacher }}</text>
        <text class="countdown-blue">{{ countdownText }}</text>
      </div>

      <!-- 状态2: 正在上课 -->
      <div if="{{ status === 'ongoing' }}" class="card-content">
        <text class="status-label status-green">正在上课</text>
        <text class="course-name">{{ currentCourse.name }}</text>
        <text class="time-info status-green">剩余 {{ remainingMinutes }} 分钟</text>
        <text class="location-info">{{ currentCourse.classroom }} · {{ currentCourse.teacher }}</text>
        <div class="progress-container">
          <progress class="progress-bar" percent="{{ progress }}"></progress>
          <text class="progress-text">{{ progressPercent }}%</text>
        </div>
      </div>

      <!-- 状态3: 今日课程结束 -->
      <div if="{{ status === 'finished' }}" class="card-content">
        <text class="status-label status-gray">今日课程已结束</text>
        <text class="next-label">{{ nextCourseLabel }}</text>
        <text class="course-name">{{ nextCourse.name }}</text>
        <text class="time-info">{{ nextCourse.startTime }} · {{ nextCourse.classroom }}</text>
      </div>

      <!-- 状态4: 今日无课 -->
      <div if="{{ status === 'noClass' }}" class="card-content">
        <text class="status-label status-gray">今日无课</text>
        <div if="{{ nearestExam }}" class="exam-preview">
          <text class="exam-label">{{ examCountdown.isOngoing ? '考试进行中' : '最近考试还有' }}</text>
          <text class="exam-countdown">{{ examCountdown.value }} {{ examCountdown.unit }}</text>
          <text if="{{ examCountdown.isOngoing && examCountdown.remainingMinutes > 0 }}" class="exam-remaining">剩余{{ examCountdown.remainingMinutes }}分钟</text>
          <text class="exam-course">{{ nearestExam.course }}</text>
        </div>
      </div>
    </div>

    <!-- 底部摘要 -->
    <div class="summary-row">
      <!-- 课表入口 -->
      <div class="summary-card schedule-card" onclick="goToSchedule">
        <text class="summary-icon status-blue">课表</text>
        <text class="summary-count status-blue">{{ todayCourseCount }} 节</text>
      </div>

      <!-- 考试摘要 -->
      <div class="summary-card exam-card" onclick="goToExam">
        <text class="summary-icon status-red">考试</text>
        <text class="summary-count status-red">{{ examSummary.count }} 场</text>
      </div>

      <!-- 待办摘要 -->
      <div class="summary-card task-card" onclick="goToTask">
        <text class="summary-icon status-purple">待办</text>
        <text class="summary-count status-purple">{{ taskSummary.totalCount }} 项</text>
      </div>
    </div>

    <!-- 底部应用标识（隐藏 Debug 入口） -->
    <div class="app-brand" @click="onBrandClick">
      <text class="brand-text">VELA CLASS</text>
    </div>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 466px;
  height: 466px;
  padding-top: 40px;
  padding-bottom: 20px;
}

.header {
  flex-direction: column;
  align-items: center;
  margin-bottom: 15px;
}

.time {
  font-size: 48px;
  font-weight: 700;
  color: #FFFFFF;
}

.date {
  font-size: 18px;
  color: #A0A0A0;
  margin-top: 3px;
}

.main-card {
  width: 380px;
  height: 165px;
  border-radius: 28px;
  background-color: #171717;
  padding: 15px 20px;
  margin-bottom: 15px;
}

.main-card-blue {
  border: 1px solid rgba(79, 163, 255, 0.4);
}

.main-card-green {
  border: 1px solid rgba(88, 214, 141, 0.4);
}

.card-content {
  flex-direction: column;
  justify-content: center;
}

.status-label {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 4px;
}

.status-blue {
  color: #4FA3FF;
}

.status-green {
  color: #58D68D;
}

.status-red {
  color: #FF6B6B;
}

.status-purple {
  color: #B57BFF;
}

.status-gray {
  color: #8F8F8F;
}

.course-name {
  font-size: 30px;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 4px;
}

.time-info {
  font-size: 22px;
  color: #CFCFCF;
  margin-bottom: 3px;
}

.location-info {
  font-size: 16px;
  color: #A0A0A0;
  margin-bottom: 4px;
}

.countdown-blue {
  font-size: 24px;
  font-weight: 700;
  color: #4FA3FF;
}

.countdown-green {
  font-size: 28px;
  font-weight: 700;
  color: #58D68D;
}

.next-label {
  font-size: 16px;
  color: #8F8F8F;
  margin-bottom: 4px;
}

.progress-container {
  flex-direction: row;
  align-items: center;
  margin-top: 6px;
}

.progress-bar {
  width: 280px;
  color: #58D68D;
  layer-color: #2B2B2B;
  stroke-width: 8px;
}

.progress-text {
  font-size: 18px;
  font-weight: 600;
  color: #58D68D;
  margin-left: 10px;
}

.exam-preview {
  flex-direction: column;
  align-items: center;
  margin-top: 15px;
}

.exam-label {
  font-size: 16px;
  color: #8F8F8F;
}

.exam-countdown {
  font-size: 38px;
  font-weight: 700;
  color: #FF6B6B;
  margin: 5px 0;
}

.exam-remaining {
  font-size: 16px;
  color: #58D68D;
  margin-bottom: 2px;
}

.exam-course {
  font-size: 20px;
  color: #FFFFFF;
}

.summary-row {
  flex-direction: row;
  justify-content: space-between;
  width: 380px;
}

.summary-card {
  width: 120px;
  height: 75px;
  border-radius: 22px;
  background-color: #171717;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.schedule-card {
  margin-right: 10px;
}

.exam-card {
  margin-left: 5px;
  margin-right: 5px;
}

.task-card {
  margin-left: 10px;
}

.summary-icon {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 4px;
}

.summary-count {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 2px;
}

.app-brand {
  margin-top: 12px;
  padding: 5px;
}

.brand-text {
  font-size: 12px;
  color: #333333;
}
</style>

<script>
import router from '@system.router'
import { getCurrentCourse, getNextCourse, getNextCourseAcrossDays, getCourseProgress, getCourseRemainingTime, getMinutesUntilStart, getTodayCourses, isTodayCoursesFinished } from '../../common/schedule'
import { getNearestExam, getExamCountdown, getExamSummary } from '../../common/exam'
import { getTaskSummary } from '../../common/task'
import { getNow, formatTime, formatFullDate } from '../../common/time'
import { ensureStorageReady, refreshExamsFromStorage, refreshTasksFromStorage, refreshCoursesFromStorage, syncMockDataSetting } from '../../common/storage'

// 性能诊断：记录首页启动时间
const HOME_PERF_START = Date.now()
function perfLog(label) {
  console.log('[PERF:HOME]', label, '+', Date.now() - HOME_PERF_START, 'ms')
}

// 调试模式：设置为 null 使用真实时间，设置为 Date 对象使用模拟时间
const DEBUG_NOW = null
// 示例：模拟正在上课 (10:30)
// const DEBUG_NOW = new Date(2026, 7, 18, 10, 30, 0)
// 示例：模拟今日课程结束 (18:00)
// const DEBUG_NOW = new Date(2026, 7, 18, 18, 0, 0)
// 示例：模拟今日无课（周日）
// const DEBUG_NOW = new Date(2026, 7, 23, 10, 0, 0)

export default {
  private: {
    currentTime: '',
    currentDate: '',
    status: 'next', // next, ongoing, finished, noClass
    mainCardClass: '',
    currentCourse: null,
    nextCourse: null,
    remainingMinutes: 0,
    progress: 0,
    progressPercent: 0,
    countdownText: '',
    nextCourseLabel: '',
    nearestExam: null,
    currentExam: null,  // 保存当前最近考试对象，用于轻量刷新倒计时
    examCountdown: { value: 0, unit: '', status: '', isOngoing: false, remainingMinutes: 0 },
    examSummary: { count: 0, nearestCourse: null },
    taskSummary: { todayCount: 0, totalCount: 0, urgentCount: 0 },
    todayCourseCount: 0,
    timeTimer: null,    // 时间更新定时器（1秒）
    courseTimer: null,  // 课程状态定时器（30秒）
    examTimer: null,    // 考试倒计时定时器（60秒）
    debugClickCount: 0,
    debugClickTimer: null
  },

  onInit() {
    perfLog('HOME_INIT_START')
    
    const updateTimeStart = Date.now()
    this.updateTime()
    perfLog('HOME_UPDATE_TIME: ' + (Date.now() - updateTimeStart) + 'ms')

    perfLog('HOME_ENSURE_STORAGE_START')
    ensureStorageReady()
      .then(() => syncMockDataSetting())
      .then(() => {
        perfLog('HOME_STORAGE_READY')
        
        // 首次加载完整数据
        this.updateStaticSummary()  // 考试和待办摘要
        this.updateCourseStatus()   // 课程状态
        
        perfLog('HOME_READY')

        // 启动定时器
        this.startTimers()
      })
      .catch((err) => {
        console.error('Failed to initialize storage on home:', err)
        perfLog('HOME_STORAGE_ERROR: ' + err.message)
        
        // 即使出错也要显示数据
        this.updateStaticSummary()
        this.updateCourseStatus()
        perfLog('HOME_READY (error path)')

        this.startTimers()
      })
    perfLog('HOME_INIT_END')
  },

  onShow() {
    perfLog('HOME_SHOW_START')
    
    // 从其他页面返回时，先同步Mock数据设置，再刷新数据
    ensureStorageReady()
      .then(() => syncMockDataSetting())
      .then(() => Promise.all([
        refreshExamsFromStorage(),
        refreshTasksFromStorage(),
        refreshCoursesFromStorage()
      ]))
      .then(() => {
        perfLog('HOME_SHOW_STORAGE_READY')
        this.updateTime()
        this.updateStaticSummary()  // 刷新考试和待办摘要
        this.updateCourseStatus()   // 刷新课程状态
        this.startTimers()          // 重新启动定时器
        perfLog('HOME_SHOW_END')
      })
      .catch((err) => {
        console.error('Failed to refresh home:', err)
        perfLog('HOME_SHOW_ERROR: ' + err.message)
        this.updateTime()
        this.updateStaticSummary()
        this.updateCourseStatus()
        this.startTimers()          // 重新启动定时器
        perfLog('HOME_SHOW_END (error)')
      })
  },

  onHide() {
    perfLog('HOME_HIDE')
    // 页面隐藏时清理定时器
    this.clearTimers()
  },

  onDestroy() {
    perfLog('HOME_DESTROY')
    this.clearTimers()
  },

  // 启动定时器
  startTimers() {
    this.clearTimers()
    
    // 时间定时器：每1秒更新时间
    this.timeTimer = setInterval(() => {
      this.updateTime()
    }, 1000)
    
    // 课程状态定时器：每30秒更新课程状态
    this.courseTimer = setInterval(() => {
      this.updateCourseStatus()
    }, 30000)
    
    // 考试倒计时定时器：每60秒更新考试倒计时
    this.examTimer = setInterval(() => {
      this.updateExamCountdown()
    }, 60000)
    
    perfLog('TIMERS_STARTED (1s time, 30s course, 60s exam)')
  },

  // 清理定时器
  clearTimers() {
    if (this.timeTimer) {
      clearInterval(this.timeTimer)
      this.timeTimer = null
    }
    if (this.courseTimer) {
      clearInterval(this.courseTimer)
      this.courseTimer = null
    }
    if (this.examTimer) {
      clearInterval(this.examTimer)
      this.examTimer = null
    }
    if (this.debugClickTimer) {
      clearTimeout(this.debugClickTimer)
      this.debugClickTimer = null
    }
  },

  updateTime() {
    const now = getNow(DEBUG_NOW)
    this.currentTime = formatTime(now)
    this.currentDate = formatFullDate(now)
  },

  // 更新静态摘要：考试和待办（仅在 onShow 时调用）
  updateStaticSummary() {
    perfLog('UPDATE_STATIC_SUMMARY_START')
    const now = getNow(DEBUG_NOW)

    // 考试信息
    const nearestExamStart = Date.now()
    const nearestExam = getNearestExam(now)
    this.nearestExam = nearestExam
    this.currentExam = nearestExam  // 保存当前考试对象用于轻量刷新
    if (nearestExam) {
      this.examCountdown = getExamCountdown(nearestExam, now)
    } else {
      // 没有考试时重置
      this.examCountdown = { value: 0, unit: '', status: '', isOngoing: false, remainingMinutes: 0 }
    }
    this.examSummary = getExamSummary(now)
    perfLog('getNearestExam+getExamSummary: ' + (Date.now() - nearestExamStart) + 'ms, count:' + this.examSummary.count)

    // 待办信息
    const taskSummaryStart = Date.now()
    this.taskSummary = getTaskSummary(now)
    perfLog('getTaskSummary: ' + (Date.now() - taskSummaryStart) + 'ms, total:' + this.taskSummary.totalCount)

    perfLog('UPDATE_STATIC_SUMMARY_END')
  },

  // 轻量刷新考试倒计时（每60秒调用，不重新查询考试列表）
  updateExamCountdown() {
    if (this.currentExam) {
      const now = getNow(DEBUG_NOW)
      this.examCountdown = getExamCountdown(this.currentExam, now)
    }
  },

  // 更新课程状态（每30秒调用）
  updateCourseStatus() {
    perfLog('UPDATE_COURSE_STATUS_START')
    const now = getNow(DEBUG_NOW)

    // 获取当前课程
    const currentCourseStart = Date.now()
    const currentCourse = getCurrentCourse(now)
    perfLog('getCurrentCourse: ' + (Date.now() - currentCourseStart) + 'ms')
    
    // 获取下一节课
    const nextCourseStart = Date.now()
    const nextCourse = getNextCourse(now)
    perfLog('getNextCourse: ' + (Date.now() - nextCourseStart) + 'ms')
    
    // 获取跨天的下一节课
    const nextAcrossStart = Date.now()
    const nextAcross = getNextCourseAcrossDays(now)
    perfLog('getNextCourseAcrossDays: ' + (Date.now() - nextAcrossStart) + 'ms')
    
    // 今日课程是否结束
    const todayFinishedStart = Date.now()
    const todayFinished = isTodayCoursesFinished(now)
    perfLog('isTodayCoursesFinished: ' + (Date.now() - todayFinishedStart) + 'ms')
    
    // 今日课程列表
    const todayCoursesStart = Date.now()
    const todayCourses = getTodayCourses(now)
    perfLog('getTodayCourses: ' + (Date.now() - todayCoursesStart) + 'ms')

    // 今日课程数量
    this.todayCourseCount = todayCourses.length

    // 判断状态
    if (currentCourse) {
      // 正在上课
      this.status = 'ongoing'
      this.mainCardClass = 'main-card-green'
      this.currentCourse = currentCourse
      this.remainingMinutes = getCourseRemainingTime(currentCourse, now)
      this.progress = Math.round(getCourseProgress(currentCourse, now) * 100)
      this.progressPercent = this.progress
    } else if (nextCourse) {
      // 有下一节课
      this.status = 'next'
      this.mainCardClass = 'main-card-blue'
      this.nextCourse = nextCourse
      const minutes = getMinutesUntilStart(nextCourse, now)
      this.countdownText = `还有 ${minutes} 分钟`
    } else if (todayFinished && todayCourses.length > 0) {
      // 今日课程结束
      this.status = 'finished'
      this.mainCardClass = ''
      if (nextAcross) {
        this.nextCourse = nextAcross.course
        if (nextAcross.daysLater === 1) {
          this.nextCourseLabel = '明天第一节'
        } else {
          const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
          const date = new Date(now)
          date.setDate(date.getDate() + nextAcross.daysLater)
          this.nextCourseLabel = `下一节课 · ${days[date.getDay()]}`
        }
      } else {
        this.nextCourse = { name: '暂无安排', startTime: '', classroom: '' }
        this.nextCourseLabel = '近期无课'
      }
    } else {
      // 今日无课
      this.status = 'noClass'
      this.mainCardClass = ''
    }
    
    perfLog('UPDATE_COURSE_STATUS_END')
  },

  goToCourseDetail() {
    const course = this.status === 'ongoing' ? this.currentCourse : this.nextCourse
    if (course && course.id) {
      router.push({
        uri: '/pages/course-detail',
        params: {
          courseId: course.id
        }
      })
    }
  },

  goToExam() {
    router.push({
      uri: '/pages/exam'
    })
  },

  goToTask() {
    router.push({
      uri: '/pages/task'
    })
  },

  goToSchedule() {
    router.push({
      uri: '/pages/schedule'
    })
  },

  onBrandClick() {
    this.debugClickCount++

    // 清除之前的定时器
    if (this.debugClickTimer) {
      clearTimeout(this.debugClickTimer)
    }

    // 检查是否达到5次
    if (this.debugClickCount >= 5) {
      this.debugClickCount = 0
      router.push({
        uri: '/pages/debug'
      })
      return
    }

    // 2秒内没有继续点击则重置计数
    this.debugClickTimer = setTimeout(() => {
      this.debugClickCount = 0
    }, 2000)
  }
}
</script>
