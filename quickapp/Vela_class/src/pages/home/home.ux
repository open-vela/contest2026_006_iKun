<template>
  <div class="page">
    <!-- 顶部时间 -->
    <div class="header">
      <div if="{{ semesterWeek > 0 }}" class="semester-row">
        <text class="semester-text">第{{ semesterWeek }}周/16周</text>
        <progress class="semester-progress" percent="{{ semesterProgress }}"></progress>
      </div>
      <text if="{{ semesterWeek === 0 }}" class="semester-empty">学期未开始</text>
      <text class="time">{{ currentTime }}</text>
      <text class="date">{{ currentDate }}</text>
    </div>

    <!-- 主卡片 -->
    <div class="main-card {{ mainCardClass }}" onclick="goToCourseDetail">
      <!-- 状态1: 下一节课 -->
      <div if="{{ status === 'next' }}" class="card-content">
        <text class="status-label status-blue">下一节课</text>
        <text class="course-name">{{ nextCourse.name }}</text>
        <text class="time-info">{{ nextCourse.startTime }} 开始</text>
        <text class="location-info">{{ nextCourse.classroom }} · {{ nextCourse.teacher }}</text>
        <text class="countdown-blue">{{ countdownText }}</text>
      </div>

      <!-- 状态2: 正在上课 -->
      <div if="{{ status === 'ongoing' }}" class="card-content">
        <text class="status-label status-green">正在上课</text>
        <text class="course-name">{{ currentCourse.name }}</text>
        <text class="time-info status-green">剩余 {{ remainingMinutes }} 分钟</text>
        <text class="location-info">{{ currentCourse.classroom }} · {{ currentCourse.teacher }}</text>
        <div class="progress-container">
          <progress class="progress-bar" percent="{{ progress }}"></progress>
          <text class="progress-text">{{ progressPercent }}%</text>
        </div>
      </div>

      <!-- 状态3: 今日课程结束 -->
      <div if="{{ status === 'finished' }}" class="card-content">
        <text class="status-label status-gray">今日课程已结束</text>
        <text class="next-label">{{ nextCourseLabel }}</text>
        <text class="course-name">{{ nextCourse.name }}</text>
        <text class="time-info">{{ nextCourse.startTime }} · {{ nextCourse.classroom }}</text>
      </div>

      <!-- 状态4: 今日无课 -->
      <div if="{{ status === 'noClass' }}" class="card-content {{ !nearestExam ? 'no-class-center' : '' }}">
        <text class="status-label status-gray {{ !nearestExam ? 'no-class-large' : '' }}">今日无课</text>
        <div if="{{ nearestExam }}" class="exam-preview">
          <text class="exam-label">{{ examCountdown.isOngoing ? '考试进行中' : '最近考试还有' }}</text>
          <text class="exam-countdown">{{ examCountdown.value }} {{ examCountdown.unit }}</text>
          <text if="{{ examCountdown.isOngoing && examCountdown.remainingMinutes > 0 }}" class="exam-remaining">剩余{{ examCountdown.remainingMinutes }}分钟</text>
          <text class="exam-course">{{ nearestExam.course }}</text>
        </div>
      </div>
    </div>

    <!-- 底部摘要 -->
    <div class="summary-row">
      <!-- 课表入口 -->
      <div class="summary-card schedule-card" onclick="goToSchedule">
        <text class="summary-icon status-blue">课表</text>
        <text class="summary-count status-blue">{{ todayCourseCount }} 节</text>
      </div>

      <!-- 考试摘要 -->
      <div class="summary-card exam-card" onclick="goToExam">
        <text class="summary-icon status-red">考试</text>
        <text class="summary-count status-red">{{ examSummary.count }} 场</text>
      </div>

      <!-- 待办摘要 -->
      <div class="summary-card task-card" onclick="goToTask">
        <text class="summary-icon status-purple">待办</text>
        <text class="summary-count status-purple">{{ taskSummary.totalCount }} 项</text>
      </div>
    </div>

    <!-- 底部应用标识（隐藏 Debug 入口） -->
    <div class="app-brand" @click="onBrandClick">
      <text class="brand-text">VELA CLASS</text>
    </div>
  </div>
</template>

<style>
.page {
  flex-direction: column;
  align-items: center;
  background-color: #000000;
  width: 466px;
  height: 466px;
  padding-top: 30px;
  padding-bottom: 20px;
}

.header {
  flex-direction: column;
  align-items: center;
  margin-bottom: 15px;
}

.time {
  font-size: 48px;
  font-weight: 700;
  color: #FFFFFF;
}

.date {
  font-size: 18px;
  color: #A0A0A0;
  margin-top: 3px;
}

.semester-row {
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin-top: 0;
  margin-bottom: 4px;
}

.semester-text {
  font-size: 15px;
  color: #A0A0A0;
  margin-right: 8px;
}

.semester-progress {
  width: 100px;
  height: 4px;
  color: #4FA3FF;
  layer-color: #2B2B2B;
  stroke-width: 4px;
}

.semester-empty {
  font-size: 13px;
  color: #666666;
  margin-top: 0;
  margin-bottom: 4px;
}

.main-card {
  width: 380px;
  height: 165px;
  border-radius: 28px;
  background-color: #171717;
  padding: 15px 20px;
  margin-bottom: 15px;
}

.main-card-blue {
  border: 1px solid rgba(79, 163, 255, 0.4);
}

.main-card-green {
  border: 1px solid rgba(88, 214, 141, 0.4);
}

.card-content {
  width: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.status-label {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 4px;
}

.no-class-large {
  font-size: 24px;
  text-align: center;
}

.no-class-center {
  width: 100%;
  align-items: center;
}

.status-blue {
  color: #4FA3FF;
}

.status-green {
  color: #58D68D;
}

.status-red {
  color: #FF6B6B;
}

.status-purple {
  color: #B57BFF;
}

.status-gray {
  color: #8F8F8F;
}

.course-name {
  font-size: 30px;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 4px;
}

.time-info {
  font-size: 22px;
  color: #CFCFCF;
  margin-bottom: 3px;
}

.location-info {
  font-size: 16px;
  color: #A0A0A0;
  margin-bottom: 4px;
}

.countdown-blue {
  font-size: 24px;
  font-weight: 700;
  color: #4FA3FF;
}

.countdown-green {
  font-size: 28px;
  font-weight: 700;
  color: #58D68D;
}

.next-label {
  font-size: 16px;
  color: #8F8F8F;
  margin-bottom: 4px;
}

.progress-container {
  flex-direction: row;
  align-items: center;
  margin-top: 6px;
}

.progress-bar {
  width: 280px;
  color: #58D68D;
  layer-color: #2B2B2B;
  stroke-width: 8px;
}

.progress-text {
  font-size: 18px;
  font-weight: 600;
  color: #58D68D;
  margin-left: 10px;
}

.exam-preview {
  flex-direction: column;
  align-items: center;
  margin-top: 15px;
}

.exam-label {
  font-size: 16px;
  color: #8F8F8F;
}

.exam-countdown {
  font-size: 38px;
  font-weight: 700;
  color: #FF6B6B;
  margin: 5px 0;
}

.exam-remaining {
  font-size: 16px;
  color: #58D68D;
  margin-bottom: 2px;
}

.exam-course {
  font-size: 20px;
  color: #FFFFFF;
}

.summary-row {
  flex-direction: row;
  justify-content: space-between;
  width: 380px;
}

.summary-card {
  width: 120px;
  height: 75px;
  border-radius: 22px;
  background-color: #171717;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.schedule-card {
  margin-right: 10px;
}

.exam-card {
  margin-left: 5px;
  margin-right: 5px;
}

.task-card {
  margin-left: 10px;
}

.summary-icon {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 4px;
}

.summary-count {
  font-size: 22px;
  font-weight: 700;
  margin-bottom: 2px;
}

.app-brand {
  margin-top: 12px;
  padding: 5px;
}

.brand-text {
  font-size: 12px;
  color: #333333;
}
</style>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import prompt from '@system.prompt'
import { getCurrentCourse, getNextCourse, getNextCourseAcrossDays, getCourseProgress, getCourseRemainingTime, getMinutesUntilStart, getTodayCourses, isTodayCoursesFinished, calculateCurrentWeek } from '../../common/schedule'
import { getNearestExam, getUpcomingExams, getExamCountdown, getExamSummary } from '../../common/exam'
import { getTasks, getTaskSummary } from '../../common/task'
import { getNow, formatTime, formatFullDate, parseTimeToDate, parseDateTime } from '../../common/time'
import { ensureStorageReady, refreshExamsFromStorage, refreshTasksFromStorage, refreshCoursesFromStorage, syncMockDataSetting } from '../../common/storage'



export default {
  private: {
    currentTime: '',
    currentDate: '',
    status: 'next',
    mainCardClass: '',
    currentCourse: null,
    nextCourse: null,
    remainingMinutes: 0,
    progress: 0,
    progressPercent: 0,
    countdownText: '',
    nextCourseLabel: '',
    nearestExam: null,
    currentExam: null,
    examCountdown: { value: 0, unit: '', status: '', isOngoing: false, remainingMinutes: 0 },
    examSummary: { count: 0, nearestCourse: null },
    taskSummary: { todayCount: 0, totalCount: 0, urgentCount: 0 },
    todayCourseCount: 0,
    semesterWeek: 0,
    semesterProgress: 0,
    timeTimer: null,
    courseTimer: null,
    examTimer: null,
    reminderTimer: null,
    reminderDone: {},
    debugClickCount: 0,
    debugClickTimer: null
  },

  onInit() {
    this.updateTime()

    ensureStorageReady()
      .then(() => syncMockDataSetting())
      .then(() => {
        this.updateStaticSummary()
        this.updateCourseStatus()
        this.startTimers()
        this.checkReminders()
      })
      .catch(() => {
        this.updateStaticSummary()
        this.updateCourseStatus()
        this.startTimers()
        this.checkReminders()
      })
  },

  onShow() {
    ensureStorageReady()
      .then(() => syncMockDataSetting())
      .then(() => Promise.all([
        refreshExamsFromStorage(),
        refreshTasksFromStorage(),
        refreshCoursesFromStorage()
      ]))
      .then(() => {
        this.updateTime()
        this.updateStaticSummary()
        this.updateCourseStatus()
        this.startTimers()
        this.checkReminders()
      })
      .catch(() => {
        this.updateTime()
        this.updateStaticSummary()
        this.updateCourseStatus()
        this.startTimers()
        this.checkReminders()
      })
  },

  onHide() {
    this.clearTimers()
  },

  onDestroy() {
    this.clearTimers()
  },

  startTimers() {
    this.clearTimers()
    
    this.timeTimer = setInterval(() => {
      this.updateTime()
    }, 1000)
    
    this.courseTimer = setInterval(() => {
      this.updateCourseStatus()
    }, 30000)
    
    this.examTimer = setInterval(() => {
      this.updateExamCountdown()
    }, 60000)

    this.reminderTimer = setInterval(() => {
      this.checkReminders()
    }, 30000)
  },

  clearTimers() {
    if (this.timeTimer) {
      clearInterval(this.timeTimer)
      this.timeTimer = null
    }
    if (this.courseTimer) {
      clearInterval(this.courseTimer)
      this.courseTimer = null
    }
    if (this.examTimer) {
      clearInterval(this.examTimer)
      this.examTimer = null
    }
    if (this.reminderTimer) {
      clearInterval(this.reminderTimer)
      this.reminderTimer = null
    }
    if (this.debugClickTimer) {
      clearTimeout(this.debugClickTimer)
      this.debugClickTimer = null
    }
  },

  updateTime() {
    const now = getNow()
    this.currentTime = formatTime(now)
    this.currentDate = formatFullDate(now)
  },

  updateStaticSummary() {
    const now = getNow()

    // 学期周次计算
    const currentWeek = calculateCurrentWeek(now)
    this.semesterWeek = currentWeek
    if (currentWeek > 0) {
      this.semesterProgress = Math.round(currentWeek / 16 * 100)
    } else {
      this.semesterProgress = 0
    }

    const nearestExam = getNearestExam(now)
    this.nearestExam = nearestExam
    this.currentExam = nearestExam
    if (nearestExam) {
      this.examCountdown = getExamCountdown(nearestExam, now)
    } else {
      this.examCountdown = { value: 0, unit: '', status: '', isOngoing: false, remainingMinutes: 0 }
    }
    this.examSummary = getExamSummary(now)

    this.taskSummary = getTaskSummary(now)
  },

  updateExamCountdown() {
    if (this.currentExam) {
      const now = getNow()
      this.examCountdown = getExamCountdown(this.currentExam, now)
    }
  },

  updateCourseStatus() {
    const now = getNow()

    const currentCourse = getCurrentCourse(now)
    const nextCourse = getNextCourse(now)
    const nextAcross = getNextCourseAcrossDays(now)
    const todayFinished = isTodayCoursesFinished(now)
    const todayCourses = getTodayCourses(now)

    this.todayCourseCount = todayCourses.length

    if (currentCourse) {
      this.status = 'ongoing'
      this.mainCardClass = 'main-card-green'
      this.currentCourse = currentCourse
      this.remainingMinutes = getCourseRemainingTime(currentCourse, now)
      this.progress = Math.round(getCourseProgress(currentCourse, now) * 100)
      this.progressPercent = this.progress
    } else if (nextCourse) {
      this.status = 'next'
      this.mainCardClass = 'main-card-blue'
      this.nextCourse = nextCourse
      const minutes = getMinutesUntilStart(nextCourse, now)
      this.countdownText = `还有 ${minutes} 分钟`
    } else if (todayFinished && todayCourses.length > 0) {
      this.status = 'finished'
      this.mainCardClass = ''
      if (nextAcross) {
        this.nextCourse = nextAcross.course
        if (nextAcross.daysLater === 1) {
          this.nextCourseLabel = '明天第一节'
        } else {
          const days = ['周日', '周一', '周二', '周三', '周四', '周五', '周六']
          const date = new Date(now)
          date.setDate(date.getDate() + nextAcross.daysLater)
          this.nextCourseLabel = `下一节课 · ${days[date.getDay()]}`
        }
      } else {
        this.nextCourse = { name: '暂无安排', startTime: '', classroom: '' }
        this.nextCourseLabel = '近期无课'
      }
    } else {
      this.status = 'noClass'
      this.mainCardClass = ''
    }
  },

  checkReminders() {
    const now = getNow()
    const todayStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`

    // 课程提醒：距下一节课开始 0 < diff <= 10 分钟
    const nextCourse = getNextCourse(now)
    if (nextCourse) {
      const courseKey = `${nextCourse.id}_${todayStr}`
      if (!this.reminderDone[courseKey]) {
        const startTime = parseTimeToDate(nextCourse.startTime, now)
        const diff = Math.ceil((startTime - now) / 60000)
        if (diff > 0 && diff <= 10) {
          this.reminderDone[courseKey] = true
          this.triggerReminder(`《${nextCourse.name}》${diff}分钟后开始`, 'short')
        }
      }
    }

    // 考试提醒：取最近一场「尚未开始」的考试（开始时间 > now），0 < diff <= 60 分钟
    const upcomingExams = getUpcomingExams(now)
    const nearestUpcoming = upcomingExams.find(e => {
      const examStart = parseDateTime(`${e.date}T${e.startTime}:00`)
      return examStart && examStart > now
    })
    if (nearestUpcoming) {
      const examKey = nearestUpcoming.id
      if (!this.reminderDone[examKey]) {
        const examStart = parseDateTime(`${nearestUpcoming.date}T${nearestUpcoming.startTime}:00`)
        const diff = Math.ceil((examStart - now) / 60000)
        if (diff > 0 && diff <= 60) {
          this.reminderDone[examKey] = true
          this.triggerReminder(`《${nearestUpcoming.course}》考试${diff}分钟后开始`, 'long')
        }
      }
    }

    // 待办截止提醒：距最近未完成待办截止 0 < diff <= 60 分钟
    const tasks = getTasks().filter(t => !t.finished)
    const upcomingTasks = tasks
      .map(t => {
        const deadline = parseDateTime(t.deadline)
        if (!deadline || deadline <= now) return null
        const diff = Math.ceil((deadline - now) / 60000)
        return { ...t, deadline, diff }
      })
      .filter(t => t && t.diff > 0 && t.diff <= 60)
      .sort((a, b) => a.diff - b.diff)

    if (upcomingTasks.length > 0) {
      const task = upcomingTasks[0]
      const taskKey = task.id
      if (!this.reminderDone[taskKey]) {
        this.reminderDone[taskKey] = true
        this.triggerReminder(`《${task.title}》${task.diff}分钟后截止`, 'long')
      }
    }
  },

  triggerReminder(message, mode) {
    vibrator.vibrate({ mode: mode || 'short' })
    prompt.showToast({ message: message, duration: 3000 })
  },

  goToCourseDetail() {
    const course = this.status === 'ongoing' ? this.currentCourse : this.nextCourse
    if (course && course.id) {
      router.push({
        uri: '/pages/course-detail',
        params: {
          courseId: course.id
        }
      })
    }
  },

  goToExam() {
    router.push({
      uri: '/pages/exam'
    })
  },

  goToTask() {
    router.push({
      uri: '/pages/task'
    })
  },

  goToSchedule() {
    router.push({
      uri: '/pages/schedule'
    })
  },

  onBrandClick() {
    this.debugClickCount++

    if (this.debugClickTimer) {
      clearTimeout(this.debugClickTimer)
    }

    if (this.debugClickCount >= 5) {
      this.debugClickCount = 0
      router.push({
        uri: '/pages/debug'
      })
      return
    }

    this.debugClickTimer = setTimeout(() => {
      this.debugClickCount = 0
    }, 2000)
  }
}
</script>
